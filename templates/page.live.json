      "settings": {
        "custom_liquid": "{% comment %}\n  SATOMI NISHIKIGOI — LIVE PAGE\n  Paste this whole file into a \"Custom liquid\" section on the \"live\" page template.\n\n  It reads from three places you manage in Shopify, never in this code:\n    - Open wheels:   every product in the collection with the handle below (e.g. \"Koi Roulette\").\n    (The full wheel cards and the winners wall now live on the Wheels page, /pages/wheels.)\n    - Twitch:        your channel name.\n{% endcomment %}\n{%- assign wheels_collection = 'koi-roulette' -%}\n{%- assign winners_blog = 'winners' -%}\n{%- assign twitch_channel = 'satominishikigoi' -%}\n{%- assign whatsapp_link = 'https://chat.whatsapp.com/LxB67oWJEB52pTrPfyBY14' -%}\n{%- assign youtube_link = 'https://www.youtube.com/channel/UCnyjMSPTshtwLeiV0terjqg' -%}\n\n{%- assign wheels = collections[wheels_collection].products -%}\n{%- assign winners = blogs[winners_blog] -%}\n{%- assign winners_count = winners.articles_count | plus: 0 -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sn-live{--w:#f5f3ef; --g:#a3a09b; --dim:#6e6b67; --r:#d70f0f; --glow:#f91e11; --edge:rgba(245,243,239,.14);\n    background:#000; color:var(--w); font-family:'EB Garamond', Georgia, serif; padding:44px 16px 80px}\n  .sn-live *{box-sizing:border-box}\n  .sn-l-in{max-width:1100px; margin:0 auto}\n  .sn-l-eyebrow{font-family:'Cinzel',serif; font-size:12px; letter-spacing:.32em; text-transform:uppercase; color:var(--r); margin:0 0 10px; text-align:center}\n  .sn-live h1, .sn-live h2{font-family:'Cinzel',serif; font-weight:600; letter-spacing:.05em; line-height:1.15; text-align:center}\n  .sn-live h1{font-size:clamp(30px,5.5vw,48px); margin:0 0 10px}\n  .sn-live h2{font-size:clamp(24px,4vw,34px); margin:0 0 8px}\n  .sn-l-sub{font-size:19px; color:var(--g); text-align:center; max-width:36em; margin:0 auto 26px; line-height:1.5}\n  .sn-l-block{margin:0 0 64px}\n\n  .sn-tv{position:relative; aspect-ratio:16/9; background:#0b0b0b; border:1px solid var(--edge); border-top:2px solid var(--r); border-radius:4px; overflow:hidden}\n  .sn-tv{display:block !important}\n  .sn-tv iframe{position:absolute; inset:0; width:100%; height:100%; border:0; display:block}\n  .sn-l-btns{display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin:16px 0 0}\n  .sn-l-btn{display:inline-block; min-width:220px; padding:14px 20px; border-radius:3px; text-align:center; text-decoration:none;\n    font-family:'Cinzel',serif; font-weight:600; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n    background:var(--r); color:#fff; box-shadow:0 0 18px rgba(215,15,15,.35)}\n  .sn-l-btn:hover{background:var(--glow); color:#fff}\n  .sn-l-btn.line{background:transparent; border:1px solid rgba(245,243,239,.4); color:var(--w); box-shadow:none}\n  .sn-l-btn.line:hover{border-color:var(--r)}\n\n  .sn-cards{display:grid; grid-template-columns:repeat(3,1fr); gap:16px}\n  @media (max-width:900px){ .sn-cards{grid-template-columns:repeat(2,1fr)} }\n  @media (max-width:600px){ .sn-cards{grid-template-columns:1fr} .sn-l-btn{display:block; width:100%; min-width:0} }\n  .sn-card{display:flex; flex-direction:column; background:#0b0b0b; border:1px solid var(--edge); border-radius:4px; overflow:hidden; text-decoration:none; color:var(--w); transition:border-color .2s}\n  .sn-card:hover{border-color:rgba(215,15,15,.6); color:var(--w)}\n  .sn-card-img{display:block; aspect-ratio:4/3; background:radial-gradient(circle at 50% 42%,#b30c0c 0,#6a0808 22%,#140606 46%,#000 70%); background-size:cover; background-position:center}\n  .sn-card-body{padding:16px; display:flex; flex-direction:column; gap:8px; flex:1}\n  .sn-card-tag{font-family:'Cinzel',serif; font-size:10px; letter-spacing:.26em; text-transform:uppercase; color:var(--glow)}\n  .sn-card-tag.full{color:var(--g)}\n  .sn-card h3{font-family:'Cinzel',serif; font-weight:600; font-size:20px; letter-spacing:.04em; margin:0}\n  .sn-card-meta{font-size:16px; color:var(--g); margin:0}\n  .sn-card-bar{height:6px; border-radius:99px; background:rgba(245,243,239,.1); overflow:hidden}\n  .sn-card-bar i{display:block; height:100%; background:linear-gradient(90deg,#8e0a0a,var(--glow))}\n  .sn-card-go{margin-top:auto; font-family:'Cinzel',serif; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:var(--w)}\n  .sn-empty{text-align:center; color:var(--g); font-size:18px; background:#0b0b0b; border:1px dashed var(--edge); border-radius:4px; padding:28px 16px}\n  .sn-empty a{color:var(--w)}\n  .sn-rows{display:flex; flex-direction:column; gap:8px; max-width:640px; margin:0 auto}\n  .sn-row{display:grid; grid-template-columns:auto 1fr auto; gap:14px; align-items:center; background:#0b0b0b; border:1px solid var(--edge); border-radius:4px; padding:14px 16px; text-decoration:none; color:var(--w)}\n  .sn-row:hover{border-color:rgba(215,15,15,.6); color:var(--w)}\n  .sn-row b{font-family:'Cinzel',serif; font-weight:600; font-size:17px; letter-spacing:.04em}\n  .sn-row-bar{height:8px; border-radius:99px; background:rgba(245,243,239,.1); overflow:hidden}\n  .sn-row-bar i{display:block; height:100%; background:linear-gradient(90deg,#8e0a0a,var(--glow))}\n  .sn-row-txt{font-size:16px; color:var(--g); white-space:nowrap}\n  .sn-win-excerpt{font-size:16px; line-height:1.5; color:var(--g); margin:0}\n</style>\n\n<section class=\"sn-live\" id=\"snLive\">\n  <div class=\"sn-l-in\">\n\n    <div class=\"sn-l-block\">\n      <p class=\"sn-l-eyebrow\">Satomi Live</p>\n      <h1>Watch it happen</h1>\n      <p class=\"sn-l-sub\">Every Koi Roulette spin happens live on Twitch. If I'm on, you'll see it right here.</p>\n      <div class=\"sn-tv\" id=\"snTv\" data-channel=\"{{ twitch_channel }}\" data-host=\"{{ request.host }}\"></div>\n      <div class=\"sn-l-btns\">\n        <a class=\"sn-l-btn\" href=\"https://www.twitch.tv/{{ twitch_channel }}\" target=\"_blank\" rel=\"noopener\">Follow on Twitch</a>\n        <a class=\"sn-l-btn line\" href=\"{{ whatsapp_link }}\" target=\"_blank\" rel=\"noopener\">Get the spin alerts on WhatsApp</a>\n      </div>\n    </div>\n\n    <div class=\"sn-l-block\" style=\"margin-bottom:0\">\n      <p class=\"sn-l-eyebrow\">On the board now</p>\n      {%- assign shown = 0 -%}\n      <div class=\"sn-rows\">\n        {%- for p in wheels -%}\n          {%- assign total = p.variants.size -%}\n          {%- if total < 2 -%}{%- continue -%}{%- endif -%}\n          {%- assign taken = 0 -%}\n          {%- for v in p.variants -%}{%- unless v.available -%}{%- assign taken = taken | plus: 1 -%}{%- endunless -%}{%- endfor -%}\n          {%- assign left = total | minus: taken -%}\n          {%- assign shown = shown | plus: 1 -%}\n          <a class=\"sn-row\" href=\"{{ p.url }}\">\n            <b>{{ p.title }}</b>\n            <span class=\"sn-row-bar\"><i style=\"width:{{ taken | times: 100 | divided_by: total }}%\"></i></span>\n            <span class=\"sn-row-txt\">{% if left > 0 %}{{ left }} left{% else %}Full · spin soon{% endif %}</span>\n          </a>\n        {%- endfor -%}\n      </div>\n      {%- if shown == 0 -%}\n        <p class=\"sn-empty\">No wheels open right now. New ones go out in the <a href=\"{{ whatsapp_link }}\" target=\"_blank\" rel=\"noopener\">WhatsApp group</a> first.</p>\n      {%- endif -%}\n      <div class=\"sn-l-btns\">\n        <a class=\"sn-l-btn\" href=\"/pages/wheels\">See the wheels</a>\n        <a class=\"sn-l-btn line\" href=\"/pages/wheels#spun\">Past spins &amp; winners</a>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('snLive'); if (!root) return;\n  if (root.parentElement) root.parentElement.style.padding = '0';\n  var band = root.closest('.gradient'); if (band) band.style.background = '#000';\n\n  // Twitch player (Twitch needs to be told which website it's on)\n  var tv = document.getElementById('snTv');\n  var host = tv.getAttribute('data-host') || location.hostname;\n  var parents = [host, location.hostname, 'satominishikigoi.com', 'www.satominishikigoi.com', 'admin.shopify.com', 'satomi-nishikigoi.myshopify.com']\n    .filter(function(h, i, a){ return h && a.indexOf(h) === i; })\n    .map(function(h){ return '&parent=' + encodeURIComponent(h); }).join('');\n  var f = document.createElement('iframe');\n  f.src = 'https://player.twitch.tv/?channel=' + encodeURIComponent(tv.getAttribute('data-channel')) + parents + '&muted=true&autoplay=true';\n  f.allowFullscreen = true; f.title = 'Satomi Nishikigoi on Twitch'; f.loading = 'lazy';\n  tv.appendChild(f);\n})();\n</script>",
