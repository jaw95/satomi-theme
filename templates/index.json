      "name": "Harvest Code",
      "settings": {
        "custom_liquid": "{% comment %}\n  SATOMI NISHIKIGOI — HOMEPAGE: TOSAI HARVEST\n  Paste this whole file into a \"Custom liquid\" section under the banner section.\n\n  The lines below are all you'll ever change:\n    title        the heading\n    harvest_on   harvest date and time (year-month-day T hour:minute)\n    breeders     breeder | varieties (separated with commas) | photo link, breeders separated with ;\n    story        a few words in your own voice\n    after_text   what shows once harvest day has passed\n\n  Breeder photos: in Shopify go to Content > Files, click the link icon on the photo,\n  and paste that link as the third part of the breeder's entry above.\n{% endcomment %}\n{%- assign title = 'Hoshikin, Marudo & Hiroi Tosai Harvest' -%}\n{%- assign harvest_on = '2026-11-03T10:00' -%}\n{%- assign breeders = 'Hoshikin|Showa|https://cdn.shopify.com/s/files/1/0882/6644/1049/files/hoshikin-photo.jpg?v=1790775335;Marudo|Sanke|https://cdn.shopify.com/s/files/1/0882/6644/1049/files/marudo-photo.jpg?v=1790775313;Hiroi|Goshiki, Gin Rin Goshiki, Tancho Goshiki, Chagoi, Kohaku, Gin Rin Showa, Gin Rin Kohaku|https://cdn.shopify.com/s/files/1/0882/6644/1049/files/hiroi-photo.jpg?v=1790775273' -%}\n{%- assign story = \"These arrived as tosai on 1 February. While I've been a bit stale and busy building the new facility this year, they've been ticking over on an auto feeder in the big pond of the new facility. They're all much bigger now. On harvest day I'll net the pond. Every koi gets photographed and goes to Supporters in the WhatsApp group first, then the whole group, then the website and YouTube. Once they've been harvested and selected, the best will go back in to grow on until March, when they'll be nisai.\" -%}\n{%- assign after_text = \"The harvest's in. Every koi has been photographed and gone to Supporters first, then the WhatsApp group, then the website and YouTube. The best have gone back in to grow on until March.\" -%}\n{%- assign whatsapp_link = 'https://chat.whatsapp.com/LxB67oWJEB52pTrPfyBY14' -%}\n{%- assign youtube_link = 'https://www.youtube.com/channel/UCnyjMSPTshtwLeiV0terjqg' -%}\n\n<style>\n  .sn-harv{\n    --sn-white:#f5f3ef; --sn-grey:#a3a09b; --sn-red:#d70f0f; --sn-glow:#f91e11; --sn-edge:rgba(245,243,239,.14);\n    background:#000; color:var(--sn-white); font-family:'EB Garamond', Georgia, serif; padding:56px 16px 72px;\n  }\n  .sn-harv *{box-sizing:border-box}\n  .sn-harv-in{max-width:860px; margin:0 auto; text-align:center}\n  .sn-harv-eyebrow{font-family:'Cinzel',serif; font-size:12px; letter-spacing:.32em; text-transform:uppercase; color:var(--sn-red); margin:0 0 12px}\n  .sn-harv h2{font-family:'Cinzel',serif; font-weight:600; letter-spacing:.05em; font-size:clamp(28px,5vw,42px); line-height:1.15; margin:0 0 26px}\n\n  .sn-hcount{display:flex; justify-content:center; gap:10px; margin:0 0 10px}\n  .sn-hunit{min-width:84px; padding:16px 8px; border:1px solid var(--sn-edge); border-radius:4px; background:#0b0b0b}\n  .sn-hunit:first-child{border-top:2px solid var(--sn-red)}\n  .sn-hunit b{display:block; font-family:'Cinzel',serif; font-size:36px; font-weight:600; font-variant-numeric:tabular-nums; text-shadow:0 0 18px rgba(249,30,17,.3)}\n  .sn-hunit span{display:block; font-family:'Cinzel',serif; font-size:10px; letter-spacing:.22em; text-transform:uppercase; color:var(--sn-grey); margin-top:4px}\n  .sn-hwhen{font-style:italic; font-size:18px; color:var(--sn-grey); margin:0 0 28px}\n  .sn-hdone{font-size:20px; color:var(--sn-white); margin:0 0 28px}\n  .sn-harv [hidden]{display:none !important}\n  .sn-vchips{display:flex; flex-wrap:wrap; justify-content:center; gap:6px; margin:8px 0 0; padding:0; list-style:none}\n  .sn-vchips li{padding:6px 12px; border:1px solid rgba(245,243,239,.22); border-radius:99px; font-size:15px; color:var(--sn-white)}\n  .sn-breeder.wide{grid-column:1 / -1}\n  .sn-breeder.wide.has-photo{min-height:320px}\n  .sn-harv-story{font-size:19px; line-height:1.6; color:var(--sn-grey); max-width:34em; margin:0 auto 34px}\n\n  .sn-breeders{display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin:0 0 36px}\n  .sn-breeder{position:relative; overflow:hidden; background:#0b0b0b; border:1px solid var(--sn-edge); border-radius:4px; padding:20px 12px}\n  .sn-breeder > *{position:relative; z-index:1}\n  .sn-breeder.has-photo{min-height:260px; display:flex; flex-direction:column; justify-content:flex-end; padding:20px 14px 18px}\n  .sn-breeder > .sn-bphoto{position:absolute; z-index:0; inset:0; background-size:cover; background-position:center 30%; opacity:.5; pointer-events:none}\n  .sn-breeder > .sn-bshade{position:absolute; z-index:0; inset:0; pointer-events:none;\n    background:linear-gradient(to top, rgba(0,0,0,.92) 0%, rgba(0,0,0,.55) 38%, rgba(0,0,0,0) 70%)}\n  .sn-breeder > .sn-bphoto, .sn-breeder > .sn-bshade{display:block !important}\n  .sn-breeder.has-photo b{font-size:22px; text-shadow:0 2px 10px rgba(0,0,0,.8)}\n  .sn-breeder.has-photo span, .sn-breeder.has-photo small{text-shadow:0 1px 6px rgba(0,0,0,.9)}\n  .sn-breeder .sn-with{display:block; font-style:italic; font-size:14px; color:var(--sn-grey); margin:6px 0 0}\n  .sn-breeder small{display:block; font-family:'Cinzel',serif; font-size:10px; letter-spacing:.26em; text-transform:uppercase; color:var(--sn-red); margin:0 0 8px}\n  .sn-breeder b{display:block; font-family:'Cinzel',serif; font-weight:600; font-size:20px; letter-spacing:.04em; margin:0 0 4px}\n  .sn-breeder span{font-style:italic; font-size:17px; color:var(--sn-grey)}\n\n\n  .sn-harv-btn{display:inline-block; min-width:280px; padding:15px 24px; border-radius:3px; text-decoration:none;\n    font-family:'Cinzel',serif; font-weight:600; font-size:14px; letter-spacing:.14em; text-transform:uppercase;\n    border:1px solid rgba(245,243,239,.4); color:var(--sn-white)}\n  .sn-harv-btn:hover{border-color:var(--sn-red); color:#fff}\n  .sn-harv-btns{display:flex; flex-wrap:wrap; justify-content:center; gap:12px}\n  .sn-harv-btn.sn-solid{background:var(--sn-red); border-color:var(--sn-red); color:#fff; box-shadow:0 0 18px rgba(215,15,15,.35)}\n  .sn-harv-btn.sn-solid:hover{background:var(--sn-glow)}\n  @media (max-width:600px){ .sn-breeders{grid-template-columns:1fr} .sn-harv-btns{flex-direction:column} .sn-harv-btn{display:block; width:100%; min-width:0} .sn-hunit{min-width:0; flex:1} .sn-hunit b{font-size:28px} }\n</style>\n\n<section class=\"sn-harv\" id=\"snHarvest\" data-at=\"{{ harvest_on }}\">\n  <div class=\"sn-harv-in\">\n    <p class=\"sn-harv-eyebrow\">Harvest day</p>\n    <h2>{{ title }}</h2>\n\n    <div id=\"snHBefore\">\n      <div class=\"sn-hcount\">\n        <div class=\"sn-hunit\"><b data-u=\"d\">--</b><span>Days</span></div>\n        <div class=\"sn-hunit\"><b data-u=\"h\">--</b><span>Hours</span></div>\n        <div class=\"sn-hunit\"><b data-u=\"m\">--</b><span>Mins</span></div>\n        <div class=\"sn-hunit\"><b data-u=\"s\">--</b><span>Secs</span></div>\n      </div>\n      <p class=\"sn-hwhen\">till harvest · <span id=\"snHWhen\"></span></p>\n    </div>\n    <p class=\"sn-hdone\" id=\"snHAfter\" hidden>{{ after_text }}</p>\n\n    <p class=\"sn-harv-story\">{{ story }}</p>\n\n    <div class=\"sn-breeders\">\n      {%- assign blist = breeders | split: ';' -%}\n      {%- for b in blist -%}\n        {%- assign bp = b | split: '|' -%}\n        {%- assign vlist = bp[1] | split: ',' -%}\n        {%- assign photo = bp[2] | strip -%}\n        <div class=\"sn-breeder{% if photo != blank %} has-photo{% endif %}{% if vlist.size > 1 %} wide{% endif %}\">\n          {%- if photo != blank -%}\n          <div class=\"sn-bphoto\" aria-hidden=\"true\" style=\"background-image:url('{{ photo }}')\"></div>\n          <div class=\"sn-bshade\" aria-hidden=\"true\"></div>\n          {%- endif -%}\n          <small>Breeder</small><b>{{ bp[0] | strip }}</b>\n          {%- if vlist.size > 1 -%}\n            <ul class=\"sn-vchips\">{%- for v in vlist -%}<li>{{ v | strip }}</li>{%- endfor -%}</ul>\n          {%- else -%}\n            <span>{{ bp[1] | strip }}</span>\n          {%- endif -%}\n        </div>\n      {%- endfor -%}\n    </div>\n\n    <div class=\"sn-harv-btns\">\n      <a class=\"sn-harv-btn\" href=\"/pages/harvest\">What happens on harvest day</a>\n      <a class=\"sn-harv-btn sn-solid\" href=\"{{ whatsapp_link }}\" target=\"_blank\" rel=\"noopener\">Join the WhatsApp group</a>\n      <a class=\"sn-harv-btn\" href=\"{{ youtube_link }}\" target=\"_blank\" rel=\"noopener\">Watch on YouTube</a>\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('snHarvest'); if (!root) return;\n  if (root.parentElement) root.parentElement.style.padding = '0';\n  var band = root.closest('.gradient'); if (band) band.style.background = '#000';\n\n  var at = new Date(root.getAttribute('data-at'));\n  var before = document.getElementById('snHBefore'), after = document.getElementById('snHAfter');\n  document.getElementById('snHWhen').textContent = at.toLocaleDateString('en-GB', { weekday:'long', day:'numeric', month:'long' });\n\n  var el = {}; ['d','h','m','s'].forEach(function(k){ el[k] = root.querySelector('[data-u=\"'+k+'\"]'); });\n  function pad(n){ return n < 10 ? '0'+n : ''+n; }\n  function tick(){\n    var t = at.getTime() - Date.now();\n    if (isNaN(t) || t <= 0){ before.hidden = true; after.hidden = false; return false; }\n    el.d.textContent = Math.floor(t/864e5);\n    el.h.textContent = pad(Math.floor(t/36e5)%24);\n    el.m.textContent = pad(Math.floor(t/6e4)%60);\n    el.s.textContent = pad(Math.floor(t/1e3)%60);\n    return true;\n  }\n  if (tick()){ var iv = setInterval(function(){ if (!tick()) clearInterval(iv); }, 1000); }\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
