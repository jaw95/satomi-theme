      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SATOMI NISHIKIGOI — HOMEPAGE: BANNER + NEXT UP\n  Paste this whole file into a \"Custom liquid\" section at the top of the homepage.\n\n  The banner picture: upload satomi-banner.jpg in Shopify (Content > Files). The code finds it by name.\n\n  The events list below is the only thing you'll change. Each event is:\n    date and time | title | one line about it | button words | button link\n  The date is written year-month-day then T then the time, e.g. 2027-03-01T10:00\n  Events are separated with a ;\n  The section always shows whichever event is next, and moves on by itself once it has passed.\n{% endcomment %}\n{%- assign events = '2027-03-01T10:00|Opening day|Koi back on sale and the new facility open for business. Everything happens in the WhatsApp group first.|Join the WhatsApp group|https://chat.whatsapp.com/LxB67oWJEB52pTrPfyBY14' -%}\n{%- assign banner_file = 'satomi-banner.jpg' -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sn-hero{\n    --sn-white:#f5f3ef; --sn-grey:#a3a09b; --sn-dim:#6e6b67; --sn-red:#d70f0f; --sn-glow:#f91e11; --sn-edge:rgba(245,243,239,.14);\n    background:#000; color:var(--sn-white); font-family:'EB Garamond', Georgia, serif;\n  }\n  .sn-hero *{box-sizing:border-box}\n  .sn-hero-img{position:relative; background:#000}\n  .sn-hero-img img{display:block; width:100%; height:auto; max-height:78vh; object-fit:cover; object-position:center 45%}\n  .sn-hero-img::after{content:\"\"; position:absolute; left:0; right:0; bottom:0; height:28%; background:linear-gradient(transparent,#000); pointer-events:none}\n\n  .sn-next{position:relative; max-width:720px; margin:0 auto; padding:34px 16px 64px; text-align:center;\n    background:radial-gradient(ellipse 70% 60% at 50% 110%, rgba(215,15,15,.22), transparent 70%)}\n  .sn-next-eyebrow{font-family:'Cinzel',serif; font-size:12px; letter-spacing:.32em; text-transform:uppercase; color:var(--sn-red); margin:0 0 12px}\n  .sn-next h2{font-family:'Cinzel',serif; font-weight:600; letter-spacing:.05em; font-size:clamp(28px,5vw,44px); line-height:1.15; margin:0 0 8px; color:var(--sn-white)}\n  .sn-next-when{font-style:italic; font-size:19px; color:var(--sn-grey); margin:0 0 24px}\n  .sn-count{display:flex; justify-content:center; gap:10px; margin:0 0 24px}\n  .sn-unit{min-width:76px; padding:14px 8px; border:1px solid var(--sn-edge); border-radius:4px; background:#0d0d0d}\n  .sn-num{display:block; font-family:'Cinzel',serif; font-size:32px; font-weight:600; font-variant-numeric:tabular-nums}\n  .sn-lbl{display:block; font-family:'Cinzel',serif; font-size:10px; letter-spacing:.22em; text-transform:uppercase; color:var(--sn-grey); margin-top:4px}\n  .sn-next-text{font-size:19px; line-height:1.55; color:var(--sn-grey); margin:0 auto 26px; max-width:32em}\n  .sn-next-btn{display:inline-block; min-width:260px; padding:15px 24px; border-radius:3px; text-decoration:none;\n    font-family:'Cinzel',serif; font-weight:600; font-size:14px; letter-spacing:.14em; text-transform:uppercase;\n    background:var(--sn-red); color:#fff; box-shadow:0 0 18px rgba(215,15,15,.35)}\n  .sn-next-btn:hover{background:var(--sn-glow); color:#fff}\n  .sn-next-line{height:2px; width:min(420px,80%); margin:0 auto 28px; border:0;\n    background:linear-gradient(90deg,transparent,var(--sn-glow),transparent); box-shadow:0 0 12px rgba(249,30,17,.7)}\n  .sn-next [hidden]{display:none}\n  @media (max-width:480px){ .sn-unit{min-width:0; flex:1} .sn-num{font-size:26px} .sn-next-btn{display:block; min-width:0} }\n</style>\n\n<section class=\"sn-hero\" id=\"snHero\">\n  <div class=\"sn-hero-img\">\n    <img src=\"{{ banner_file | file_url }}\" alt=\"Satomi Nishikigoi, Japanese koi sales\" width=\"1672\" height=\"941\" fetchpriority=\"high\">\n  </div>\n\n  <div class=\"sn-next\" id=\"snNext\" data-events=\"{{ events | escape }}\">\n    <hr class=\"sn-next-line\">\n    <p class=\"sn-next-eyebrow\">Next up</p>\n    <h2 data-f=\"title\">&nbsp;</h2>\n    <p class=\"sn-next-when\" data-f=\"when\">&nbsp;</p>\n    <div class=\"sn-count\">\n      <div class=\"sn-unit\"><span class=\"sn-num\" data-u=\"d\">--</span><span class=\"sn-lbl\">Days</span></div>\n      <div class=\"sn-unit\"><span class=\"sn-num\" data-u=\"h\">--</span><span class=\"sn-lbl\">Hours</span></div>\n      <div class=\"sn-unit\"><span class=\"sn-num\" data-u=\"m\">--</span><span class=\"sn-lbl\">Mins</span></div>\n      <div class=\"sn-unit\"><span class=\"sn-num\" data-u=\"s\">--</span><span class=\"sn-lbl\">Secs</span></div>\n    </div>\n    <p class=\"sn-next-text\" data-f=\"text\"></p>\n    <a class=\"sn-next-btn\" data-f=\"btn\" href=\"#\" target=\"_blank\" rel=\"noopener\" hidden></a>\n  </div>\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('snHero'); if (!root) return;\n\n  // Black background, no grey padding round this section\n  if (root.parentElement) root.parentElement.style.padding = '0';\n  var band = root.closest('.gradient'); if (band) band.style.background = '#000';\n\n  // Pick the next event that hasn't happened yet\n  var box = document.getElementById('snNext');\n  var list = (box.getAttribute('data-events') || '').split(';').map(function(e){\n    var p = e.split('|').map(function(x){ return x.trim(); });\n    return { at: new Date(p[0]), title: p[1] || '', text: p[2] || '', btn: p[3] || '', link: p[4] || '' };\n  }).filter(function(e){ return !isNaN(e.at); }).sort(function(a,b){ return a.at - b.at; });\n\n  var now = Date.now();\n  var next = list.filter(function(e){ return e.at.getTime() > now; })[0];\n  if (!next){ box.style.display = 'none'; return; }\n\n  function f(name){ return box.querySelector('[data-f=\"'+name+'\"]'); }\n  f('title').textContent = next.title;\n  f('when').textContent = next.at.toLocaleDateString('en-GB', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) +\n    ' · ' + (function(d){ var h = d.getHours(), m = d.getMinutes(); var ap = h < 12 ? 'am' : 'pm'; h = h % 12 || 12; return h + (m ? ':' + (m < 10 ? '0' + m : m) : '') + ap; })(next.at);\n  f('text').textContent = next.text;\n  if (next.btn && next.link){ var b = f('btn'); b.textContent = next.btn; b.href = next.link; b.hidden = false; }\n\n  // Countdown\n  var el = {}; ['d','h','m','s'].forEach(function(k){ el[k] = box.querySelector('[data-u=\"'+k+'\"]'); });\n  function pad(n){ return n < 10 ? '0'+n : ''+n; }\n  function tick(){\n    var t = next.at.getTime() - Date.now();\n    if (t <= 0){ location.reload(); return; }\n    el.d.textContent = Math.floor(t/864e5);\n    el.h.textContent = pad(Math.floor(t/36e5)%24);\n    el.m.textContent = pad(Math.floor(t/6e4)%60);\n    el.s.textContent = pad(Math.floor(t/1e3)%60);\n  }\n  tick(); setInterval(tick, 1000);\n})();\n</script>",
        "color_scheme": "",
