      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SATOMI NISHIKIGOI · HELPFUL LINKS (2027 site)\n  Paste this whole file into a \"Custom liquid\" section on the Helpful Links page template.\n  The WhatsApp and YouTube links are the two lines below.\n{% endcomment %}\n{%- assign whatsapp_link = 'https://chat.whatsapp.com/LxB67oWJEB52pTrPfyBY14' -%}\n{%- assign youtube_link = 'https://www.youtube.com/channel/UCnyjMSPTshtwLeiV0terjqg' -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .shl{--ink:#000;--coal:#0d0d0d;--coal2:#141414;--white:#f5f3ef;--grey:#a3a09b;--dim:#6e6b67;--red:#d70f0f;--glow:#f91e11;--edge:rgba(245,243,239,.14);\n    background:radial-gradient(ellipse 60% 22% at 50% 0%,rgba(215,15,15,.18),transparent 70%),var(--ink);\n    color:var(--white);font-family:'EB Garamond',Georgia,serif;padding:64px 16px 80px;box-sizing:border-box}\n  .shl *{box-sizing:border-box}\n  .shl-wrap{max-width:1040px;margin:0 auto}\n  .shl-kicker{display:block;font-family:'Cinzel',serif;font-size:12px;letter-spacing:.32em;text-transform:uppercase;color:var(--red);text-align:center;margin:0 0 10px}\n  .shl h1{font-family:'Cinzel',serif;font-weight:600;font-size:clamp(32px,6vw,52px);letter-spacing:.05em;line-height:1.1;margin:0 0 12px;text-align:center;color:var(--white)}\n  .shl-intro{font-size:19px;line-height:1.55;color:var(--grey);max-width:36em;margin:0 auto 44px;text-align:center}\n  .shl-line{height:2px;width:min(360px,70%);margin:0 auto 22px;border:0;background:linear-gradient(90deg,transparent,var(--glow),transparent);box-shadow:0 0 12px rgba(249,30,17,.6)}\n\n  /* helper */\n  .shl-help{background:var(--coal);border:1px solid var(--edge);border-top:2px solid var(--red);border-radius:4px;padding:28px 24px 26px;margin:0 0 28px}\n  .shl-help h2,.shl-sec h2{font-family:'Cinzel',serif;font-weight:600;font-size:clamp(20px,3.4vw,26px);letter-spacing:.06em;margin:0 0 6px;color:var(--white)}\n  .shl-help > p{font-size:17px;color:var(--grey);margin:0 0 18px}\n  .shl-chips{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 4px}\n  .shl-chip{font-family:'Cinzel',serif;font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;\n    background:#000;color:var(--white);border:1px solid rgba(245,243,239,.28);border-radius:99px;padding:11px 16px;cursor:pointer;line-height:1.2}\n  .shl-chip:hover{border-color:var(--red)}\n  .shl-chip[aria-pressed=\"true\"]{background:var(--red);border-color:var(--red);color:#fff;box-shadow:0 0 16px rgba(215,15,15,.4)}\n  .shl-ans{display:none;margin:20px 0 0;padding:20px 0 0;border-top:1px solid var(--edge)}\n  .shl-ans.on{display:block;animation:shl-in .3s ease}\n  @keyframes shl-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\n  .shl-ans h3{font-family:'Cinzel',serif;font-weight:600;font-size:18px;letter-spacing:.06em;color:var(--white);margin:0 0 6px}\n  .shl-ans .why{font-size:17px;line-height:1.5;color:var(--grey);margin:0 0 14px}\n  .shl-steps{margin:0 0 16px;padding:0;list-style:none;counter-reset:s}\n  .shl-steps li{position:relative;padding:0 0 10px 38px;font-size:18px;line-height:1.45;color:var(--white);counter-increment:s}\n  .shl-steps li::before{content:counter(s);position:absolute;left:0;top:1px;width:26px;height:26px;border-radius:50%;\n    background:rgba(215,15,15,.15);border:1px solid var(--red);color:#fff;font-family:'Cinzel',serif;font-size:13px;display:flex;align-items:center;justify-content:center}\n  .shl-go{display:flex;flex-wrap:wrap;gap:10px}\n  .shl-go a{font-family:'Cinzel',serif;font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;\n    color:var(--white);border:1px solid rgba(245,243,239,.35);border-radius:3px;padding:11px 14px}\n  .shl-go a:hover{border-color:var(--red);color:#fff}\n  .shl-go a.red{background:var(--red);border-color:var(--red);color:#fff}\n  .shl-josh{font-style:italic;font-size:16px;color:var(--grey);margin:14px 0 0}\n  .shl-josh a{color:var(--white)}\n\n\n  /* link sections */\n  .shl-sec{margin:0 0 40px}\n  .shl-sec > p{font-size:17px;color:var(--grey);margin:0 0 16px}\n  .shl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}\n  .shl-card{display:flex;flex-direction:column;background:var(--coal);border:1px solid var(--edge);border-radius:4px;padding:18px 18px 16px;text-decoration:none;color:inherit;\n    transition:border-color .2s,transform .2s,background .2s}\n  .shl-card:hover{border-color:var(--red);transform:translateY(-2px);background:var(--coal2)}\n  .shl-card small{font-family:'Cinzel',serif;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--red);margin:0 0 6px}\n  .shl-card strong{font-family:'Cinzel',serif;font-weight:600;font-size:17px;letter-spacing:.04em;color:var(--white);margin:0 0 6px;line-height:1.25}\n  .shl-card span{font-size:16px;line-height:1.45;color:var(--grey);flex:1}\n  .shl-card i{font-style:normal;font-family:'Cinzel',serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);margin-top:12px}\n  .shl-card:hover i{color:var(--white)}\n\n  .shl-sign{text-align:center;margin:56px 0 0}\n  .shl-sign p{font-size:18px;color:var(--grey);margin:0 0 16px}\n  .shl-sign a{display:inline-block;font-family:'Cinzel',serif;font-weight:600;font-size:14px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;\n    background:var(--red);color:#fff;border-radius:3px;padding:14px 22px;box-shadow:0 0 18px rgba(215,15,15,.35)}\n  .shl-small{font-size:14px;color:var(--dim);text-align:center;margin:26px auto 0;max-width:40em;line-height:1.5}\n  @media (max-width:749px){.shl{padding:44px 14px 64px}.shl-help{padding:22px 16px}.shl-chip{font-size:12px;padding:10px 13px}}\n</style>\n\n<section class=\"shl\" id=\"shl\">\n  <div class=\"shl-wrap\">\n    <span class=\"shl-kicker\">Learn</span>\n    <h1>Helpful Links</h1>\n    <hr class=\"shl-line\">\n    <p class=\"shl-intro\">The people and places I trust after 20-odd years in the hobby. If something's not right with your fish, start with the helper below.</p>\n\n    <div class=\"shl-help\">\n      <h2>Something's wrong with my koi?</h2>\n      <p>Tap what you're seeing.</p>\n      <div class=\"shl-chips\" role=\"group\" aria-label=\"What are you seeing?\">\n        <button type=\"button\" class=\"shl-chip\" data-a=\"gasp\" aria-pressed=\"false\">Gasping at the top</button>\n        <button type=\"button\" class=\"shl-chip\" data-a=\"flash\" aria-pressed=\"false\">Flashing or rubbing</button>\n        <button type=\"button\" class=\"shl-chip\" data-a=\"bottom\" aria-pressed=\"false\">Sitting on the bottom</button>\n        <button type=\"button\" class=\"shl-chip\" data-a=\"red\" aria-pressed=\"false\">Red marks or ulcers</button>\n        <button type=\"button\" class=\"shl-chip\" data-a=\"dying\" aria-pressed=\"false\">Several sick or dying</button>\n        <button type=\"button\" class=\"shl-chip\" data-a=\"green\" aria-pressed=\"false\">Green or cloudy water</button>\n        <button type=\"button\" class=\"shl-chip\" data-a=\"new\" aria-pressed=\"false\">New koi coming home</button>\n      </div>\n\n      <div class=\"shl-ans\" data-for=\"gasp\">\n        <h3>Gasping at the top</h3>\n        <p class=\"why\">Nearly always oxygen or water quality, and it can turn bad quickly, so act now.</p>\n        <ol class=\"shl-steps\">\n          <li>Get more air in straight away: extra airstones, turn up the waterfall or return.</li>\n          <li>Test ammonia and nitrite.</li>\n          <li>If either is up, do a partial water change with dechlorinated water.</li>\n          <li>Stop feeding until the readings are back to zero.</li>\n        </ol>\n        <div class=\"shl-go\">\n          <a href=\"https://cuttlebrookkoifarm.co.uk/blogs/articles/understanding-nitrite\" target=\"_blank\" rel=\"noopener\">Understanding nitrite</a>\n          <a href=\"http://www.lincsfishhealth.co.uk/\" target=\"_blank\" rel=\"noopener\">Lincs Fish Health</a>\n        </div>\n      </div>\n\n      <div class=\"shl-ans\" data-for=\"flash\">\n        <h3>Flashing, rubbing or jumping</h3>\n        <p class=\"why\">Often parasites, sometimes water quality. Don't guess and throw treatments in. Find out what it is first.</p>\n        <ol class=\"shl-steps\">\n          <li>Test your water so you can rule that out.</li>\n          <li>Get a scrape looked at under a microscope by a fish vet or an experienced keeper.</li>\n          <li>Treat for what's actually found, at the right dose for your pond's volume.</li>\n        </ol>\n        <div class=\"shl-go\">\n          <a class=\"red\" href=\"https://www.fishvetsociety.org.uk/find-a-vet/\" target=\"_blank\" rel=\"noopener\">Find a fish vet</a>\n          <a href=\"http://www.lincsfishhealth.co.uk/\" target=\"_blank\" rel=\"noopener\">Lincs Fish Health</a>\n          <a href=\"https://cuttlebrookkoifarm.co.uk/pages/diagnosing-and-treating-sick-koi\" target=\"_blank\" rel=\"noopener\">Diagnosing sick koi</a>\n        </div>\n      </div>\n\n      <div class=\"shl-ans\" data-for=\"bottom\">\n        <h3>Sitting on the bottom, fins clamped</h3>\n        <p class=\"why\">In cold water, koi slow right down, and that's normal. If the water's warm and they're clamped and sulking, something's up.</p>\n        <ol class=\"shl-steps\">\n          <li>Check the water temperature first.</li>\n          <li>Test ammonia, nitrite and pH.</li>\n          <li>Watch for other signs: flashing, red marks, heavy breathing. Then tap that above.</li>\n        </ol>\n        <div class=\"shl-go\">\n          <a href=\"https://cuttlebrookkoifarm.co.uk/pages/diagnosing-and-treating-sick-koi\" target=\"_blank\" rel=\"noopener\">Diagnosing sick koi</a>\n          <a href=\"http://www.lincsfishhealth.co.uk/\" target=\"_blank\" rel=\"noopener\">Lincs Fish Health</a>\n        </div>\n      </div>\n\n      <div class=\"shl-ans\" data-for=\"red\">\n        <h3>Red marks, ulcers or wounds</h3>\n        <p class=\"why\">Usually bacterial. Ulcers need the right treatment, and the best way to know which is a swab test.</p>\n        <ol class=\"shl-steps\">\n          <li>Test your water. Poor water is often behind it.</li>\n          <li>Get the fish looked at. A fish vet can swab the ulcer and find which treatment works.</li>\n          <li>Keep an eye on the others for the same signs.</li>\n        </ol>\n        <div class=\"shl-go\">\n          <a class=\"red\" href=\"https://www.fishvetsociety.org.uk/find-a-vet/\" target=\"_blank\" rel=\"noopener\">Find a fish vet</a>\n          <a href=\"https://ornamentalfish.org/fish-keeper/find-a-fish-vet-2/\" target=\"_blank\" rel=\"noopener\">OATA vet finder</a>\n          <a href=\"http://www.lincsfishhealth.co.uk/\" target=\"_blank\" rel=\"noopener\">Lincs Fish Health</a>\n        </div>\n      </div>\n\n      <div class=\"shl-ans\" data-for=\"dying\">\n        <h3>Several fish sick or dying at once</h3>\n        <p class=\"why\">Especially soon after adding new fish, with sunken eyes or damaged gills: this could be KHV. Act fast and keep everything separate.</p>\n        <ol class=\"shl-steps\">\n          <li>Don't move fish, water or nets to another pond.</li>\n          <li>If you suspect KHV, you must report it to the Fish Health Inspectorate: 01305 206700, 24 hours.</li>\n          <li>Get a fish vet out to test.</li>\n        </ol>\n        <div class=\"shl-go\">\n          <a class=\"red\" href=\"tel:01305206700\">Call the FHI</a>\n          <a href=\"https://www.gov.uk/government/news/changes-to-khv-disease-controls-in-recreational-fisheries\" target=\"_blank\" rel=\"noopener\">KHV on GOV.UK</a>\n          <a href=\"https://www.fishvetsociety.org.uk/find-a-vet/\" target=\"_blank\" rel=\"noopener\">Find a fish vet</a>\n        </div>\n      </div>\n\n      <div class=\"shl-ans\" data-for=\"green\">\n        <h3>Green or cloudy water</h3>\n        <p class=\"why\">Rarely an emergency. Green is algae, and cloudy is usually filtration catching up.</p>\n        <ol class=\"shl-steps\">\n          <li>Check your UV is on and the bulb isn't more than a year old.</li>\n          <li>Feed a bit less, and check your filter isn't blocked.</li>\n          <li>Be patient. New ponds and spring sunshine both cause it.</li>\n        </ol>\n        <div class=\"shl-go\">\n          <a href=\"https://cuttlebrookkoifarm.co.uk/blogs/articles/koi-keeping-basics\" target=\"_blank\" rel=\"noopener\">Koi keeping basics</a>\n        </div>\n      </div>\n\n      <div class=\"shl-ans\" data-for=\"new\">\n        <h3>New koi coming home</h3>\n        <p class=\"why\">The most common way problems get into a pond is with new fish. A bit of patience now saves heartache later.</p>\n        <ol class=\"shl-steps\">\n          <li>Quarantine new koi in a separate tank if you can.</li>\n          <li>Float the bag, then mix in your pond water slowly so they get used to it.</li>\n          <li>Don't feed for the first day, and watch them closely for the first fortnight.</li>\n        </ol>\n        <div class=\"shl-go\">\n          <a href=\"https://cuttlebrookkoifarm.co.uk/blogs/articles/koi-keeping-basics\" target=\"_blank\" rel=\"noopener\">Koi keeping basics</a>\n        </div>\n      </div>\n\n      <p class=\"shl-josh\">Still not sure? Post a video in the <a href=\"{{ whatsapp_link }}\" target=\"_blank\" rel=\"noopener\">WhatsApp group</a> and I'll have a look.</p>\n    </div>\n\n    <div class=\"shl-sec\">\n      <h2>Fish health</h2>\n      <p>When you need a proper answer, not a forum guess.</p>\n      <div class=\"shl-grid\">\n        <a class=\"shl-card\" href=\"http://www.lincsfishhealth.co.uk/\" target=\"_blank\" rel=\"noopener\"><small>Lab &amp; advice</small><strong>Lincolnshire Fish Health</strong><span>Koi disease research, investigations for hobbyists, and natural pond treatments. Phone them with health problems: 01205 723413, Tue to Sun, 10 to 4.</span><i>Visit site →</i></a>\n        <a class=\"shl-card\" href=\"https://www.fishvetsociety.org.uk/find-a-vet/\" target=\"_blank\" rel=\"noopener\"><small>Vets</small><strong>Find a fish vet</strong><span>Most vets won't touch koi. The Fish Veterinary Society lists the ones who will.</span><i>Search vets →</i></a>\n        <a class=\"shl-card\" href=\"https://ornamentalfish.org/fish-keeper/find-a-fish-vet-2/\" target=\"_blank\" rel=\"noopener\"><small>Vets</small><strong>OATA vet finder</strong><span>A second list of fish vets, from the Ornamental Aquatic Trade Association.</span><i>Search vets →</i></a>\n        <a class=\"shl-card\" href=\"https://cuttlebrookkoifarm.co.uk/pages/diagnosing-and-treating-sick-koi\" target=\"_blank\" rel=\"noopener\"><small>Guide</small><strong>Diagnosing &amp; treating sick koi</strong><span>Cuttlebrook's step-by-step: water, parasites, fungus, bacteria and viruses.</span><i>Read →</i></a>\n        <a class=\"shl-card\" href=\"https://cuttlebrookkoifarm.co.uk/blogs/articles/understanding-nitrite\" target=\"_blank\" rel=\"noopener\"><small>Guide</small><strong>Understanding nitrite</strong><span>Why it spikes, what it does to your koi, and how to bring it down.</span><i>Read →</i></a>\n        <a class=\"shl-card\" href=\"https://cuttlebrookkoifarm.co.uk/blogs/articles/koi-keeping-basics\" target=\"_blank\" rel=\"noopener\"><small>Guide</small><strong>Koi keeping basics</strong><span>A solid starting point if you're new to it all.</span><i>Read →</i></a>\n      </div>\n    </div>\n\n    <div class=\"shl-sec\">\n      <h2>Clubs &amp; shows</h2>\n      <p>The best way to learn is to see good koi in the flesh, with people who love them.</p>\n      <div class=\"shl-grid\">\n        <a class=\"shl-card\" href=\"https://bkks.co.uk/about/bkks-sections/\" target=\"_blank\" rel=\"noopener\"><small>Club</small><strong>British Koi-Keepers Society</strong><span>Find your local section: meetings, pond visits and like-minded keepers.</span><i>Find a section →</i></a>\n        <a class=\"shl-card\" href=\"https://bkks.co.uk/events-and-meetings/the-national-koi-show/\" target=\"_blank\" rel=\"noopener\"><small>Show</small><strong>The National Koi Show</strong><span>The BKKS's big show. Go once and you'll look at your own fish differently.</span><i>Show details →</i></a>\n        <a class=\"shl-card\" href=\"https://bkks.co.uk/guides/show-classes/\" target=\"_blank\" rel=\"noopener\"><small>Guide</small><strong>Show classes explained</strong><span>How koi are grouped and judged by variety and size.</span><i>Read →</i></a>\n        <a class=\"shl-card\" href=\"https://ysbkks.uk/\" target=\"_blank\" rel=\"noopener\"><small>Club &amp; show</small><strong>The Great British Koi Club</strong><span>Home of the Great British Koi Show.</span><i>Visit site →</i></a>\n      </div>\n    </div>\n\n    <div class=\"shl-sec\">\n      <h2>Japan</h2>\n      <p>Where nishikigoi began. See what the very best look like.</p>\n      <div class=\"shl-grid\">\n        <a class=\"shl-card\" href=\"https://zna.jp/en/\" target=\"_blank\" rel=\"noopener\"><small>全日本愛鱗会</small><strong>ZNA</strong><span>Zen Nippon Airinkai. Show results with photos of the winning koi.</span><i>Visit site →</i></a>\n        <a class=\"shl-card\" href=\"https://jnpa.info/en/nishikigoi/features/\" target=\"_blank\" rel=\"noopener\"><small>全日本錦鯉振興会</small><strong>All Japan Nishikigoi Promotion Association</strong><span>The breeders' association behind the All Japan Koi Show.</span><i>Visit site →</i></a>\n      </div>\n    </div>\n\n    <div class=\"shl-sec\">\n      <h2>Reading &amp; watching</h2>\n      <p>For the long winter evenings.</p>\n      <div class=\"shl-grid\">\n        <a class=\"shl-card\" href=\"https://www.practicalfishkeeping.co.uk/features/how-to-identify-your-koi-carp-a-complete-guide-to-koi-varieties/\" target=\"_blank\" rel=\"noopener\"><small>Guide</small><strong>Koi varieties explained</strong><span>Practical Fishkeeping's guide to telling your Kohaku from your Kujaku.</span><i>Read →</i></a>\n        <a class=\"shl-card\" href=\"{{ youtube_link }}\" target=\"_blank\" rel=\"noopener\"><small>Satomi Nishikigoi</small><strong>My YouTube channel</strong><span>Trips to Japan, koi in the bowl, and the new facility being built.</span><i>Watch →</i></a>\n      </div>\n    </div>\n\n    <div class=\"shl-sign\">\n      <p>Know a link that should be here? Tell me in the group.</p>\n      <a href=\"{{ whatsapp_link }}\" target=\"_blank\" rel=\"noopener\">Join the WhatsApp group</a>\n    </div>\n    <p class=\"shl-small\">These are links to other people's websites. I'm not responsible for what's on them. The helper above is general guidance from a keeper, not veterinary advice: if your fish are poorly, speak to a fish vet.</p>\n  </div>\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('shl'); if(!root) return;\n  var chips = root.querySelectorAll('.shl-chip'), ans = root.querySelectorAll('.shl-ans');\n  chips.forEach(function(c){\n    c.addEventListener('click', function(){\n      var on = c.getAttribute('aria-pressed') !== 'true';\n      chips.forEach(function(x){ x.setAttribute('aria-pressed','false'); });\n      ans.forEach(function(a){ a.classList.remove('on'); });\n      if (on){\n        c.setAttribute('aria-pressed','true');\n        var a = root.querySelector('.shl-ans[data-for=\"'+c.getAttribute('data-a')+'\"]');\n        if (a){ a.classList.add('on'); if (window.innerWidth < 750) a.scrollIntoView({behavior:'smooth', block:'start'}); }\n      }\n    });\n  });\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
