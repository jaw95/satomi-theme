    "custom_liquid_CQeGmr": {
      "type": "custom-liquid",
      "name": "Intro Liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  SATOMI NISHIKIGOI — COMING SOON (password page) · 2027 branding\n  Paste this whole file into a \"Custom liquid\" section on the Password page. That's it.\n  The logo is built in. Opening date and WhatsApp link are the two lines below.\n{% endcomment %}\n{%- assign opening_date = '2027-03-01T10:00:00Z' -%}\n{%- comment -%} Background photo: paste the Shopify Files link between the quotes (leave empty for no photo) {%- endcomment -%}\n{%- assign bg_photo = 'https://cdn.shopify.com/s/files/1/0882/6644/1049/files/meatyagenji.png' -%}\n{%- assign whatsapp_link = 'https://chat.whatsapp.com/LxB67oWJEB52pTrPfyBY14' -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sn-soon{\n    --sn-ink:#000; --sn-coal:#0d0d0d; --sn-white:#f5f3ef; --sn-grey:#a3a09b; --sn-dim:#6e6b67;\n    --sn-red:#d70f0f; --sn-glow:#f91e11; --sn-edge:rgba(245,243,239,.14);\n    position:relative; overflow:hidden; min-height:92vh; box-sizing:border-box;\n    display:flex; align-items:center; justify-content:center; padding:56px 16px 72px;\n    background:radial-gradient(ellipse 70% 30% at 50% 102%, rgba(215,15,15,.28), transparent 70%), var(--sn-ink);\n    color:var(--sn-white); font-family:'EB Garamond', Georgia, serif; cursor:crosshair;\n  }\n  .sn-soon *{box-sizing:border-box}\n  .sn-bgphoto{display:block !important; position:absolute; inset:0; z-index:0; pointer-events:none;\n    background-size:cover; background-repeat:no-repeat; background-position:47% 30%; opacity:.2;\n    -webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 16%,#000 72%,transparent 100%);\n            mask-image:linear-gradient(to bottom,transparent 0,#000 16%,#000 72%,transparent 100%)}\n  @media (max-width:749px){.sn-bgphoto{background-size:auto 560px; background-position:49% 90px; opacity:.24;\n    -webkit-mask-image:linear-gradient(to bottom,transparent 40px,#000 200px,#000 560px,transparent 680px); mask-image:linear-gradient(to bottom,transparent 40px,#000 200px,#000 560px,transparent 680px)}}\n  .sn-logo{mix-blend-mode:lighten}\n  .sn-soon h1,.sn-lead{text-shadow:0 1px 3px #000,0 0 18px rgba(0,0,0,.9)}\n  .sn-petals{position:absolute; inset:0; pointer-events:none; z-index:0; overflow:hidden}\n  .sn-petal{position:absolute; top:-40px; width:14px; height:10px; border-radius:0 90% 0 90%;\n    background:linear-gradient(135deg,#ff4a3d,#b30c0c); opacity:.75;\n    animation:sn-fall linear infinite, sn-sway ease-in-out infinite alternate}\n  @keyframes sn-fall{to{transform:translateY(calc(100vh + 80px)) rotate(540deg)}}\n  @keyframes sn-sway{from{margin-left:-24px}to{margin-left:24px}}\n  .sn-ripple{position:absolute; width:12px; height:12px; margin:-6px 0 0 -6px; border-radius:50%;\n    border:2px solid rgba(249,30,17,.6); pointer-events:none; z-index:1; animation:sn-ripple 1.4s ease-out forwards}\n  @keyframes sn-ripple{to{transform:scale(18); opacity:0}}\n\n  .sn-inner{position:relative; z-index:auto; max-width:620px; width:100%; text-align:center; cursor:default}\n  .sn-logo{display:block; width:min(340px,78vw); height:auto; margin:0 auto 6px}\n  .sn-logo-text{font-family:'Cinzel',serif; font-size:clamp(44px,11vw,72px); letter-spacing:.14em; margin:0}\n  .sn-line{height:2px; width:min(420px,80%); margin:6px auto 28px; border:0;\n    background:linear-gradient(90deg,transparent,var(--sn-glow),transparent); box-shadow:0 0 12px rgba(249,30,17,.7)}\n  .sn-soon h1{font-family:'Cinzel',serif; font-weight:600; font-size:clamp(24px,5vw,36px); letter-spacing:.06em; line-height:1.2; margin:0 0 16px; color:var(--sn-white)}\n  .sn-lead{font-size:19px; line-height:1.55; color:var(--sn-grey); margin:0 auto 16px; max-width:32em}\n  .sn-lead + .sn-count{margin-top:32px}\n  .sn-lead strong{color:var(--sn-white); font-weight:500}\n\n  .sn-count{display:flex; justify-content:center; gap:10px; margin:0 0 10px}\n  .sn-unit{min-width:76px; padding:14px 8px; border:1px solid var(--sn-edge); border-radius:4px; background:var(--sn-coal)}\n  .sn-num{display:block; font-family:'Cinzel',serif; font-size:32px; font-weight:600; font-variant-numeric:tabular-nums; color:var(--sn-white)}\n  .sn-lbl{display:block; font-family:'Cinzel',serif; font-size:10px; letter-spacing:.22em; text-transform:uppercase; color:var(--sn-grey); margin-top:4px}\n  .sn-until{font-family:'Cinzel',serif; font-size:12px; letter-spacing:.3em; text-transform:uppercase; color:var(--sn-red); margin:0 0 36px}\n\n  .sn-card{background:rgba(13,13,13,.85); border:1px solid var(--sn-edge); border-top:2px solid var(--sn-red); border-radius:4px;\n    padding:26px 22px; margin:0 0 26px; text-align:left}\n  .sn-card h2{font-family:'Cinzel',serif; font-weight:600; font-size:20px; letter-spacing:.08em; margin:0 0 8px; color:var(--sn-white)}\n  .sn-card p{font-size:17px; line-height:1.5; color:var(--sn-grey); margin:0 0 16px}\n  .sn-fields{display:flex; flex-wrap:wrap; gap:10px}\n  .sn-fields input{flex:1 1 180px; min-width:0; padding:13px 14px; border-radius:3px; font-size:17px; font-family:inherit;\n    border:1px solid rgba(245,243,239,.22); background:#000; color:var(--sn-white)}\n  .sn-fields input::placeholder{color:var(--sn-dim)}\n  .sn-fields input:focus{outline:none; border-color:var(--sn-red)}\n  .sn-btn{padding:14px 20px; border-radius:3px; border:0; cursor:pointer; flex:1 1 100%;\n    font-family:'Cinzel',serif; font-weight:600; font-size:15px; letter-spacing:.14em; text-transform:uppercase;\n    background:var(--sn-red); color:#fff; box-shadow:0 0 18px rgba(215,15,15,.35)}\n  .sn-btn:hover{background:var(--sn-glow)}\n  .sn-wa{display:block; text-align:center; text-decoration:none}\n  .sn-card{text-align:center}\n  /* hides Shopify's built-in email sign-up box on the password page */\n  [id*='email-signup'], [id*='email_signup'], .email-signup-banner, .newsletter{display:none !important}\n  .sn-done{font-size:18px; color:var(--sn-white); margin:0}\n  .sn-links{display:flex; justify-content:center; margin:0 0 26px}\n  .sn-ghost{flex:0 1 320px; padding:14px 18px; border-radius:3px; text-decoration:none;\n    font-family:'Cinzel',serif; font-weight:600; font-size:14px; letter-spacing:.14em; text-transform:uppercase;\n    color:var(--sn-white); border:1px solid rgba(245,243,239,.35)}\n  .sn-ghost:hover{border-color:var(--sn-red); color:#fff}\n  .sn-sign{font-style:italic; font-size:17px; color:var(--sn-grey); margin:0}\n  .sn-hint{font-family:'Cinzel',serif; font-size:10px; letter-spacing:.3em; text-transform:uppercase; color:var(--sn-dim); margin:18px 0 0}\n  @media (prefers-reduced-motion:reduce){.sn-petal,.sn-ripple{display:none}}\n  /* ---- Header: swap the shop name for the koi emblem, keep the password link ---- */\n  .password-header > h1{margin:0; line-height:0; font-size:0}\n  .sn-hlogo{display:block; height:78px; width:auto; mix-blend-mode:lighten}\n  /* whole lock screen black, no grey bands */\n  .shopify-section .gradient, .password-header{background:#000 !important}\n  .sn-hpond{display:none !important}\n  @media (max-width:749px){.sn-hlogo{height:64px; margin:0 auto 8px}}\n</style>\n\n<section class=\"sn-soon\" id=\"snSoon\">\n  {%- if bg_photo != blank and bg_photo != 'PASTE-PHOTO-LINK-HERE' -%}<div class=\"sn-bgphoto\" style=\"background-image:url('{{ bg_photo }}')\" aria-hidden=\"true\"></div>{%- endif -%}\n  <div class=\"sn-petals\" id=\"snPetals\" aria-hidden=\"true\"></div>\n\n  <div class=\"sn-inner\">\n    <img class=\"sn-logo\" src=\"https://cdn.shopify.com/s/files/1/0882/6644/1049/files/satomi-lock-logo.webp?v=1792434202\" alt=\"Satomi Nishikigoi, Japanese koi sales\" width=\"520\" height=\"520\">\n    <hr class=\"sn-line\">\n\n    <h1>The new ponds are filling up</h1>\n    <p class=\"sn-lead\">\n      My lease at the farm was ended without notice. I've moved everything to a purpose-built facility at home. This year has not been ideal, but I'm moving into 2027 with a fresh vision and a brand new facility. For the first time this year I'm genuinely excited!\n    </p>\n    <p class=\"sn-lead\">\n      It's not quite ready for visitors yet. <strong>Koi go back on sale in March</strong>, along with <strong>Koi Roulette</strong>, the weekly live draw.\n      Some of you have been waiting all year for this. I really appreciate your patience with everything.\n    </p>\n\n    <div class=\"sn-count\" id=\"snCount\" data-open=\"{{ opening_date }}\">\n      <div class=\"sn-unit\"><span class=\"sn-num\" data-u=\"d\">--</span><span class=\"sn-lbl\">Days</span></div>\n      <div class=\"sn-unit\"><span class=\"sn-num\" data-u=\"h\">--</span><span class=\"sn-lbl\">Hours</span></div>\n      <div class=\"sn-unit\"><span class=\"sn-num\" data-u=\"m\">--</span><span class=\"sn-lbl\">Mins</span></div>\n      <div class=\"sn-unit\"><span class=\"sn-num\" data-u=\"s\">--</span><span class=\"sn-lbl\">Secs</span></div>\n    </div>\n    <p class=\"sn-until\">until opening day</p>\n\n    <div class=\"sn-card\">\n      <h2>Join the WhatsApp group and be first to know!</h2>\n      <p>Everything lands in the group first: the build as it happens, opening day news, and the first Koi Roulette.</p>\n      <a class=\"sn-btn sn-wa\" href=\"{{ whatsapp_link }}\" target=\"_blank\" rel=\"noopener\">Join on WhatsApp</a>\n    </div>\n\n    <p class=\"sn-sign\">Josh, Satomi Nishikigoi</p>\n    \n  </div>\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('snSoon'); if(!root) return;\n\n  // Tidy up: remove koi left over from the old header version, drop grey padding round this section\n  document.querySelectorAll('.sn-hpond').forEach(function(el){ el.remove(); });\n  if (root.parentElement) root.parentElement.style.padding = '0';\n\n  // Koi emblem in the header, in place of the shop name\n  var title = document.querySelector('.password-header > h1');\n  if (title && !title.querySelector('.sn-hlogo')){\n    title.innerHTML = '<img class=\"sn-hlogo\" src=\"https://cdn.shopify.com/s/files/1/0882/6644/1049/files/satomi-lock-header-logo.webp?v=1792434202\" alt=\"Satomi Nishikigoi\" width=\"220\" height=\"215\">';\n  }\n\n  // Countdown\n  var box = document.getElementById('snCount');\n  var target = new Date(box.getAttribute('data-open')).getTime();\n  var el = {}; ['d','h','m','s'].forEach(function(k){ el[k] = box.querySelector('[data-u=\"'+k+'\"]'); });\n  function pad(n){ return n < 10 ? '0'+n : ''+n; }\n  function tick(){\n    var t = Math.max(0, target - Date.now());\n    el.d.textContent = Math.floor(t/864e5);\n    el.h.textContent = pad(Math.floor(t/36e5)%24);\n    el.m.textContent = pad(Math.floor(t/6e4)%60);\n    el.s.textContent = pad(Math.floor(t/1e3)%60);\n  }\n  tick(); setInterval(tick, 1000);\n\n  // Falling petals\n  var petals = document.getElementById('snPetals');\n  for (var i = 0; i < 16; i++){\n    var p = document.createElement('span');\n    var size = 8 + (i*7)%12;\n    p.className = 'sn-petal';\n    p.style.left = ((i*61)%100) + '%';\n    p.style.width = size + 'px';\n    p.style.height = Math.round(size*.7) + 'px';\n    p.style.animationDuration = (11 + (i*5)%10) + 's, ' + (2.5 + (i%4)*.6) + 's';\n    p.style.animationDelay = (-i*1.3) + 's, 0s';\n    petals.appendChild(p);\n  }\n\n  // Ripples\n  root.addEventListener('pointerdown', function(e){\n    if (e.target.closest('.sn-card, a, button, input')) return;\n    var r = root.getBoundingClientRect();\n    var s = document.createElement('span');\n    s.className = 'sn-ripple';\n    s.style.left = (e.clientX - r.left) + 'px';\n    s.style.top = (e.clientY - r.top) + 'px';\n    root.appendChild(s);\n    setTimeout(function(){ s.remove(); }, 1500);\n  });\n})();\n</script>",
