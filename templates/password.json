    "custom_liquid_fehm8a": {
      "type": "custom-liquid",
      "name": "Progress liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  SATOMI NISHIKIGOI — BUILD DIARY\n  Paste this whole file into a \"Custom liquid\" section, underneath the coming-soon section.\n  Diary entries come from a Shopify blog called \"The Build\". Each blog post = one diary entry.\n\n  The only line you'll ever change is the jobs list below.\n  Each job is: name | progress\n    progress can be:  done   or   5/6   (how many of how many)   or left empty (not started)\n  Jobs are separated with a ;\n{% endcomment %}\n{%- assign jobs = 'Ponds in|5/6;Filters fitted|5/6;Quarantine building|done;Water and fish in|4/6;Finishing touches|;Ready for opening day|' -%}\n{%- assign diary_blog = 'the-build' -%}\n\n{%- assign blog = blogs[diary_blog] -%}\n{%- assign diary_count = blog.articles_count | plus: 0 -%}\n{%- assign job_list = jobs | split: ';' -%}\n{%- assign total_pct = 0 -%}\n{%- for j in job_list -%}\n  {%- assign parts = j | split: '|' -%}\n  {%- assign prog = parts[1] | strip -%}\n  {%- if prog == 'done' -%}\n    {%- assign total_pct = total_pct | plus: 100 -%}\n  {%- elsif prog contains '/' -%}\n    {%- assign nd = prog | split: '/' -%}\n    {%- assign n = nd[0] | plus: 0 -%}{%- assign d = nd[1] | plus: 0 -%}\n    {%- if d > 0 -%}{%- assign p = n | times: 100 | divided_by: d -%}{%- assign total_pct = total_pct | plus: p -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- assign jobs_percent = total_pct | divided_by: job_list.size -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sn-diary{\n    --sn-deep:#000; --sn-cream:#f5f3ef; --sn-muted:#a3a09b; --sn-red:#d70f0f; --sn-gold:#f91e11;\n    --sn-card:#0d0d0d; --sn-line:rgba(245,243,239,.14);\n    background:var(--sn-deep); color:var(--sn-cream); padding:56px 16px 72px; font-family:'EB Garamond', Georgia, serif;\n  }\n  .sn-diary *{box-sizing:border-box}\n  .sn-d-inner{max-width:640px; margin:0 auto}\n  .sn-d-eyebrow{font-family:'Cinzel',serif; font-size:12px; letter-spacing:.3em; text-transform:uppercase; color:var(--sn-gold); margin:0 0 10px; text-align:center}\n  .sn-diary h2{font-family:'Cinzel',serif; font-weight:600; letter-spacing:.06em; font-size:clamp(24px,5vw,34px); line-height:1.2; margin:0 0 28px; text-align:center; color:var(--sn-cream)}\n\n  .sn-jobs{background:var(--sn-card); border:1px solid var(--sn-line); border-top:2px solid var(--sn-red); border-radius:4px; padding:22px; margin:0 0 40px}\n  .sn-bar{height:10px; border-radius:99px; background:rgba(244,239,230,.1); overflow:hidden; margin:0 0 8px}\n  .sn-bar span{display:block; height:100%; width:0; background:linear-gradient(90deg,#8e0a0a,var(--sn-gold)); box-shadow:0 0 10px rgba(249,30,17,.6); border-radius:99px; transition:width 1.6s ease}\n  .sn-bar-lbl{font-size:17px; color:var(--sn-muted); margin:0 0 16px}\n  .sn-job-grid{list-style:none; margin:0; padding:0}\n  .sn-job{display:flex; align-items:center; gap:12px; font-size:17px; color:var(--sn-muted); padding:9px 0; border-top:1px solid var(--sn-line)}\n  .sn-job:first-child{border-top:0}\n  .sn-job-name{flex:1}\n  .sn-count{font-family:'Cinzel',serif; font-size:14px; letter-spacing:.06em; color:var(--sn-cream); white-space:nowrap}\n  .sn-count small{color:var(--sn-muted); font-size:12px}\n  .sn-mini{display:flex; gap:3px}\n  .sn-mini i{width:9px; height:9px; border-radius:2px; background:rgba(245,243,239,.14)}\n  .sn-mini i.on{background:var(--sn-red); box-shadow:0 0 6px rgba(249,30,17,.6)}\n  .sn-job.part{color:var(--sn-cream)}\n  .sn-job.part .sn-dot{border-color:var(--sn-gold); animation:sn-pulse 1.6s ease-in-out infinite}\n  .sn-dot{flex:0 0 22px; height:22px; border-radius:50%; border:2px solid rgba(244,239,230,.3); display:flex; align-items:center; justify-content:center; font-size:12px}\n  .sn-job.done{color:var(--sn-cream)}\n  .sn-job.done .sn-dot{background:var(--sn-red); border-color:var(--sn-red); color:#fff}\n  .sn-job.now{color:var(--sn-cream)}\n  .sn-job.now .sn-dot{border-color:var(--sn-gold); animation:sn-pulse 1.6s ease-in-out infinite}\n  @keyframes sn-pulse{0%,100%{box-shadow:0 0 0 0 rgba(249,30,17,.6)}50%{box-shadow:0 0 0 7px rgba(249,30,17,0)}}\n\n  .sn-timeline{position:relative; padding-left:28px}\n  .sn-timeline::before{content:\"\"; position:absolute; left:8px; top:6px; bottom:6px; width:2px; background:var(--sn-line)}\n  .sn-entry{position:relative; margin:0 0 34px}\n  .sn-entry::before{content:\"\"; position:absolute; left:-26px; top:5px; width:14px; height:14px; border-radius:50%; background:var(--sn-red); box-shadow:0 0 0 4px var(--sn-deep), 0 0 12px rgba(249,30,17,.7)}\n  .sn-entry.sn-hidden{display:none}\n  .sn-date{font-family:'Cinzel',serif; font-size:12px; letter-spacing:.2em; text-transform:uppercase; color:var(--sn-gold); margin:0 0 6px}\n  .sn-entry h3{font-family:'Cinzel',serif; font-weight:600; letter-spacing:.04em; font-size:21px; line-height:1.25; margin:0 0 12px; color:var(--sn-cream)}\n  .sn-photo{display:block; width:100%; border-radius:4px; margin:0 0 14px; cursor:zoom-in; background:rgba(244,239,230,.06)}\n  .sn-body{font-size:18px; line-height:1.6; color:var(--sn-muted)}\n  .sn-body p{margin:0 0 12px}\n  .sn-body img, .sn-body iframe{max-width:100%; border-radius:10px}\n  .sn-body a{color:var(--sn-cream)}\n  .sn-more{display:block; margin:0 auto; padding:14px 22px; border-radius:3px; font-family:'Cinzel',serif; font-size:13px; letter-spacing:.14em; text-transform:uppercase; font-weight:600; cursor:pointer;\n    background:transparent; color:var(--sn-cream); border:1px solid rgba(244,239,230,.35)}\n  .sn-more:hover{border-color:var(--sn-red)}\n  .sn-empty{text-align:center; color:var(--sn-muted); font-size:16px; margin:0}\n\n  .sn-zoom{position:fixed; inset:0; background:rgba(0,0,0,.95); display:none; align-items:center; justify-content:center; padding:16px; z-index:9999; cursor:zoom-out}\n  .sn-zoom.open{display:flex}\n  .sn-zoom img{max-width:100%; max-height:100%; border-radius:10px}\n  @media (max-width:420px){.sn-mini{display:none}}\n  @media (prefers-reduced-motion:reduce){.sn-bar span{transition:none}.sn-job.now .sn-dot,.sn-job.part .sn-dot{animation:none}}\n</style>\n\n<section class=\"sn-diary\" id=\"snDiary\">\n  <div class=\"sn-d-inner\">\n    <p class=\"sn-d-eyebrow\">The build diary</p>\n    <h2>From hole in the ground to new koi facility</h2>\n\n    <div class=\"sn-jobs\">\n      <div class=\"sn-bar\"><span data-w=\"{{ jobs_percent }}\"></span></div>\n      <p class=\"sn-bar-lbl\">About {{ jobs_percent }}% of the way there</p>\n      <ul class=\"sn-job-grid\">\n        {%- for j in job_list -%}\n          {%- assign parts = j | split: '|' -%}\n          {%- assign prog = parts[1] | strip -%}\n          {%- assign state = '' -%}{%- assign n = 0 -%}{%- assign d = 0 -%}\n          {%- if prog == 'done' -%}{%- assign state = 'done' -%}\n          {%- elsif prog == 'now' -%}{%- assign state = 'now' -%}\n          {%- elsif prog contains '/' -%}\n            {%- assign nd = prog | split: '/' -%}{%- assign n = nd[0] | plus: 0 -%}{%- assign d = nd[1] | plus: 0 -%}\n            {%- if d > 0 and n >= d -%}{%- assign state = 'done' -%}{%- elsif n > 0 -%}{%- assign state = 'part' -%}{%- endif -%}\n          {%- endif -%}\n          <li class=\"sn-job {{ state }}\">\n            <span class=\"sn-dot\">{% if state == 'done' %}&#10003;{% endif %}</span>\n            <span class=\"sn-job-name\">{{ parts[0] | strip }}</span>\n            {%- if d > 0 and state != 'done' -%}\n              <span class=\"sn-mini\" aria-hidden=\"true\">{%- for k in (1..d) -%}<i{% if k <= n %} class=\"on\"{% endif %}></i>{%- endfor -%}</span>\n              <span class=\"sn-count\">{{ n }} <small>of</small> {{ d }}</span>\n            {%- elsif state == 'done' -%}\n              <span class=\"sn-count\"><small>Done</small></span>\n            {%- elsif state == 'now' -%}\n              <span class=\"sn-count\"><small>On it now</small></span>\n            {%- else -%}\n              <span class=\"sn-count\"><small>To do</small></span>\n            {%- endif -%}\n          </li>\n        {%- endfor -%}\n      </ul>\n    </div>\n\n    {%- if diary_count > 0 -%}\n      <div class=\"sn-timeline\">\n        {%- for article in blog.articles limit: 20 -%}\n          <article class=\"sn-entry{% if forloop.index > 3 %} sn-hidden{% endif %}\">\n            <p class=\"sn-date\">{{ article.published_at | date: '%-d %B %Y' }}</p>\n            <h3>{{ article.title }}</h3>\n            {%- if article.image -%}\n              <img class=\"sn-photo\" src=\"{{ article.image | image_url: width: 1000 }}\" alt=\"{{ article.image.alt | default: article.title | escape }}\" loading=\"lazy\">\n            {%- endif -%}\n            <div class=\"sn-body\">{{ article.content }}</div>\n          </article>\n        {%- endfor -%}\n      </div>\n      {%- if diary_count > 3 -%}\n        <button type=\"button\" class=\"sn-more\" id=\"snMore\">Show older entries</button>\n      {%- endif -%}\n    {%- else -%}\n      <p class=\"sn-empty\">First diary entry coming very soon.</p>\n    {%- endif -%}\n  </div>\n  <div class=\"sn-zoom\" id=\"snZoom\"><img alt=\"\"></div>\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('snDiary'); if(!root) return;\n\n  // Fill the progress bar when it scrolls into view\n  var bar = root.querySelector('.sn-bar span');\n  function fill(){ bar.style.width = bar.getAttribute('data-w') + '%'; }\n  if ('IntersectionObserver' in window){\n    var io = new IntersectionObserver(function(e){ if(e[0].isIntersecting){ fill(); io.disconnect(); } }, {threshold:.4});\n    io.observe(bar);\n  } else { fill(); }\n\n  // Show older entries\n  var more = document.getElementById('snMore');\n  if (more) more.addEventListener('click', function(){\n    root.querySelectorAll('.sn-entry.sn-hidden').forEach(function(a){ a.classList.remove('sn-hidden'); });\n    more.remove();\n  });\n\n  // Tap a photo to see it full size\n  var zoom = document.getElementById('snZoom'), zimg = zoom.querySelector('img');\n  root.addEventListener('click', function(e){\n    var img = e.target.closest('.sn-photo, .sn-body img');\n    if (img){ zimg.src = img.currentSrc || img.src; zoom.classList.add('open'); }\n  });\n  zoom.addEventListener('click', function(){ zoom.classList.remove('open'); });\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_rLBdVf": {
      "type": "custom-liquid",
      "name": "Supporters Liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  SATOMI NISHIKIGOI — SATOMI SUPPORTERS (claim + wall)\n  Paste this whole file into a NEW \"Custom liquid\" section on the Password page,\n  under the coming soon section.\n\n  The lines below are all you'll ever change:\n    closes_at   when claims close (two weeks after you announce it).\n                year-month-day T hour:minute:second, then +01:00 (summer time) or +00:00 (winter time)\n    claimed     the numbers you've approved, separated with ;   e.g.  069;001;042\n                (names are never shown on the wall)\n    reserved    numbers nobody can claim, separated with ;   e.g.  069;100\n{% endcomment %}\n{%- assign closes_at = '2026-10-18T20:00:00+01:00' -%}\n{%- assign claimed = '001;002;003;004;005;006;007;008;009;010;011;012;013;014;015;016;017;018;019;020;021;022;023;024;025;026;027;032;036;040;066;067;069;077' -%}\n{%- assign reserved = '' -%}\n{%- assign total = 135 -%}\n\n{%- assign people = claimed | split: ';' -%}\n{%- assign held = reserved | split: ';' -%}\n{%- assign held_count = 0 -%}\n{%- for h in held -%}{%- assign ht = h | strip -%}{%- if ht != blank -%}{%- assign held_count = held_count | plus: 1 -%}{%- endif -%}{%- endfor -%}\n{%- assign claimable = total | minus: held_count -%}\n{%- assign count = 0 -%}\n{%- for p in people -%}{%- assign pt = p | strip -%}{%- if pt != blank -%}{%- assign count = count | plus: 1 -%}{%- endif -%}{%- endfor -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+JP:wght@600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sn-sup{--w:#f5f3ef; --g:#a3a09b; --dim:#6e6b67; --r:#d70f0f; --glow:#f91e11; --edge:rgba(245,243,239,.14);\n    background:radial-gradient(ellipse 70% 30% at 50% 0%, rgba(215,15,15,.16), transparent 70%), #000;\n    color:var(--w); font-family:'EB Garamond', Georgia, serif; padding:64px 16px 80px; border-top:1px solid rgba(245,243,239,.08)}\n  .sn-sup *{box-sizing:border-box}\n  .sn-sup [hidden]{display:none !important}\n  .sn-s-in{max-width:980px; margin:0 auto; text-align:center}\n  .sn-s-eyebrow{font-family:'Cinzel',serif; font-size:12px; letter-spacing:.32em; text-transform:uppercase; color:var(--r); margin:0 0 12px}\n  .sn-sup h2{font-family:'Cinzel',serif; font-weight:600; letter-spacing:.06em; font-size:clamp(32px,6vw,52px); line-height:1.1; margin:0; color:var(--w)}\n  .sn-s-jp{font-family:'Noto Serif JP',serif; font-size:20px; letter-spacing:.4em; color:var(--glow); margin:10px 0 22px; padding-left:.4em}\n  .sn-s-lead{font-size:20px; line-height:1.55; color:var(--g); max-width:32em; margin:0 auto 36px}\n  .sn-s-lead em{color:var(--w)}\n\n  .sn-perks{display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:0 0 48px; text-align:left}\n  .sn-perk{background:#0b0b0b; border:1px solid var(--edge); border-top:2px solid var(--r); border-radius:4px; padding:20px 18px}\n  .sn-perk b{display:block; font-family:'Cinzel',serif; font-weight:600; font-size:30px; color:var(--w); line-height:1; margin:0 0 10px; text-shadow:0 0 18px rgba(249,30,17,.35)}\n  .sn-perk p{margin:0; font-size:17px; line-height:1.45; color:var(--g)}\n  .sn-perk p strong{color:var(--w); font-weight:500}\n  @media (max-width:860px){ .sn-perks{grid-template-columns:repeat(2,1fr)} }\n  @media (max-width:480px){ .sn-perks{grid-template-columns:1fr} }\n\n  .sn-status{display:flex; justify-content:center; align-items:stretch; gap:12px; flex-wrap:wrap; margin:0 0 22px}\n  .sn-stat{min-width:200px; padding:14px 18px; border:1px solid var(--edge); border-radius:4px; background:#0b0b0b}\n  .sn-stat b{display:block; font-family:'Cinzel',serif; font-weight:600; font-size:28px; font-variant-numeric:tabular-nums}\n  .sn-stat span{display:block; font-family:'Cinzel',serif; font-size:10px; letter-spacing:.22em; text-transform:uppercase; color:var(--g); margin-top:4px}\n  .sn-stat.closed b{color:var(--g)}\n\n  .sn-wall{list-style:none; margin:0 auto; padding:0; display:grid; grid-template-columns:repeat(15,1fr); gap:5px; max-width:980px}\n  .sn-wall li{position:relative; aspect-ratio:1; border:1px solid rgba(245,243,239,.12); border-radius:3px; display:flex; flex-direction:column;\n    align-items:center; justify-content:center; cursor:pointer; color:var(--dim); font-family:'Cinzel',serif; font-size:12px; letter-spacing:.04em;\n    transition:border-color .15s, transform .15s; overflow:hidden; padding:2px}\n  .sn-wall li:hover{border-color:rgba(245,243,239,.4)}\n  .sn-wall li.on{background:radial-gradient(circle at 50% 35%, #c80d0d, #6e0808 75%); border-color:#e01b12; color:#fff;\n    box-shadow:0 0 10px rgba(215,15,15,.35)}\n  .sn-wall li.on, .sn-wall li.on:hover{cursor:default; transform:none; border-color:#e01b12}\n  .sn-wall li b{font-weight:600}\n  .sn-wall li i{font-family:'EB Garamond',serif; font-style:italic; font-size:11px; letter-spacing:0; line-height:1.1; max-width:100%;\n    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; opacity:.9}\n  .sn-wall li.sel{outline:2px solid var(--w); outline-offset:1px}\n  .sn-sup.is-closed .sn-wall li:not(.on){opacity:.35}\n  .sn-wall li.res{background:repeating-linear-gradient(135deg, rgba(245,243,239,.06) 0 4px, transparent 4px 8px); color:#4a4744; border-color:rgba(245,243,239,.08)}\n  .sn-wall li.res b{text-decoration:line-through}\n  .sn-wallwrap{position:relative; max-width:980px; margin:0 auto}\n  .sn-bub{position:absolute; z-index:5; transform:translate(-50%, calc(-100% - 10px)); min-width:200px; max-width:250px; padding:10px 14px;\n    background:#f5f3ef; color:#000; border-radius:4px; text-align:center; box-shadow:0 6px 24px rgba(0,0,0,.6);\n    animation:sn-pop .18s ease-out}\n  .sn-bub::after{content:\"\"; position:absolute; left:var(--ax,50%); bottom:-7px; margin-left:-7px; border:7px solid transparent; border-bottom:0; border-top-color:#f5f3ef}\n  .sn-bub strong{display:block; font-family:'Cinzel',serif; font-weight:700; font-size:18px; letter-spacing:.05em; color:#d70f0f}\n  .sn-bub span{display:block; font-family:'EB Garamond',Georgia,serif; font-size:16px; line-height:1.3; color:#000}\n  .sn-bub button{display:block; width:100%; margin:8px 0 0; padding:9px 10px; border:0; border-radius:3px; cursor:pointer; background:#d70f0f; color:#fff;\n    font-family:'Cinzel',serif; font-weight:600; font-size:12px; letter-spacing:.12em; text-transform:uppercase}\n  .sn-bub button:hover{background:#f91e11}\n  .sn-picked{display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 14px; margin:6px 0 0; border:1px solid rgba(215,15,15,.6);\n    border-radius:3px; background:rgba(215,15,15,.1); font-size:17px; color:var(--w)}\n  .sn-picked b{font-family:'Cinzel',serif; font-weight:600; letter-spacing:.05em}\n  .sn-picked a{color:var(--g); font-size:15px; text-decoration:underline; cursor:pointer}\n  .sn-claim.flash{animation:sn-flash 1.2s ease-out}\n  @keyframes sn-flash{0%{box-shadow:0 0 0 3px rgba(249,30,17,.9)} 100%{box-shadow:0 0 0 0 rgba(249,30,17,0)}}\n  .sn-bub.below{transform:translate(-50%, 10px)}\n  .sn-bub.below::after{bottom:auto; top:-7px; border-top:0; border-bottom:7px solid #f5f3ef}\n  @keyframes sn-pop{from{opacity:0; margin-top:6px} to{opacity:1; margin-top:0}}\n  .sn-cap{min-height:1.6em; margin:14px 0 0; font-size:18px; color:var(--g); font-style:italic}\n  .sn-cap strong{font-family:'Cinzel',serif; font-style:normal; font-weight:600; color:var(--w); letter-spacing:.05em}\n  @media (max-width:860px){ .sn-wall{grid-template-columns:repeat(9,1fr); gap:4px} .sn-wall li{font-size:11px} .sn-wall li i{display:none} }\n  .sn-wall li i{font-style:normal; font-family:'Cinzel',serif; font-size:8px; letter-spacing:.14em; text-transform:uppercase; opacity:.85}\n\n  .sn-claim{max-width:560px; margin:52px auto 0; background:#0b0b0b; border:1px solid var(--edge); border-top:2px solid var(--r); border-radius:4px; padding:30px 24px; text-align:left}\n  .sn-claim h3{font-family:'Cinzel',serif; font-weight:600; font-size:24px; letter-spacing:.05em; margin:0 0 8px; text-align:center; color:var(--w)}\n  .sn-claim p, .sn-claim .sn-note{font-size:17px; line-height:1.5; color:var(--g); margin:0 0 18px; text-align:center}\n  .sn-claim .sn-note{font-size:15px; margin:16px 0 0}\n  .sn-claim label{display:block; font-family:'Cinzel',serif; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--g); margin:14px 0 6px}\n  .sn-claim label small{font-family:'EB Garamond',serif; font-size:14px; letter-spacing:0; text-transform:none; font-style:italic; color:var(--dim)}\n  .sn-sup .sn-claim input, .sn-sup .sn-claim select{display:block; width:100%; padding:12px 14px; letter-spacing:normal; font:17px 'EB Garamond',Georgia,serif; color:var(--w);\n    background:#000; border:1px solid rgba(245,243,239,.25); border-radius:3px; outline:none; box-shadow:none; -webkit-appearance:none; appearance:none; margin:0}\n  .sn-sup .sn-claim input:focus, .sn-sup .sn-claim select:focus{border-color:var(--r)}\n  .sn-sup .sn-claim select{background-image:linear-gradient(45deg,transparent 50%,var(--g) 50%),linear-gradient(135deg,var(--g) 50%,transparent 50%);\n    background-position:calc(100% - 20px) 50%, calc(100% - 14px) 50%; background-size:6px 6px; background-repeat:no-repeat; padding-right:40px}\n  .sn-sup .sn-claim button{display:block; width:100%; margin:24px 0 0; padding:16px 20px; border:0; border-radius:3px; cursor:pointer;\n    font-family:'Cinzel',serif; font-weight:600; font-size:14px; letter-spacing:.16em; text-transform:uppercase; background:var(--r); color:#fff;\n    box-shadow:0 0 18px rgba(215,15,15,.35)}\n  .sn-sup .sn-claim button:hover{background:var(--glow)}\n  .sn-err{background:rgba(215,15,15,.12); border:1px solid rgba(215,15,15,.5); color:var(--w); border-radius:3px; padding:10px 14px; font-size:16px; margin:0 0 6px}\n  .sn-done{text-align:center}\n  .sn-done .sn-seal{display:inline-flex; width:64px; height:64px; border-radius:6px; align-items:center; justify-content:center; margin:0 0 14px;\n    background:var(--r); color:#fff; font-family:'Noto Serif JP',serif; font-size:34px; box-shadow:0 0 22px rgba(215,15,15,.5); transform:rotate(-4deg)}\n  .sn-small{max-width:560px; margin:22px auto 0; font-size:14px; line-height:1.5; color:var(--dim)}\n</style>\n\n<section class=\"sn-sup\" id=\"snSup\" data-close=\"{{ closes_at }}\" data-count=\"{{ count }}\" data-total=\"{{ claimable }}\">\n  <div class=\"sn-s-in\">\n    <p class=\"sn-s-eyebrow\">For the WhatsApp group</p>\n    <h2>Satomi Supporters</h2>\n    <p class=\"sn-s-jp\">支援会員</p>\n    <p class=\"sn-s-lead\">I haven't sold a single koi this year, and you stuck with me anyway. So this is for you, and <em>only you</em>.</p>\n\n    <div class=\"sn-perks\">\n      <div class=\"sn-perk\"><b>25%</b><p><strong>off every koi</strong>, for as long as Satomi sells koi.</p></div>\n      <div class=\"sn-perk\"><b>25%</b><p><strong>off your first spot</strong> on every Koi Roulette wheel.</p></div>\n      <div class=\"sn-perk\"><b>1st</b><p><strong>look at new koi and deals</strong>, before anyone else, forever.</p></div>\n      <div class=\"sn-perk\"><b>No.</b><p><strong>Your own numbered certificate</strong>, Supporter 001 to {{ total }}.</p></div>\n    </div>\n\n    <div class=\"sn-status\">\n      <div class=\"sn-stat\"><b>{{ count }} <small style=\"font-size:.55em;color:var(--g)\">of {{ total }}</small></b><span>Supporters so far</span></div>\n      <div class=\"sn-stat\" id=\"snSupClock\"><b>&nbsp;</b><span>till claims close</span></div>\n    </div>\n\n    <div class=\"sn-wallwrap\" id=\"snWallWrap\">\n    <ul class=\"sn-wall\" id=\"snWall\">\n      {%- for n in (1..total) -%}\n        {%- assign num = n | prepend: '00' | slice: -3, 3 -%}\n        {%- assign who = '' -%}{%- assign town = '' -%}{%- assign taken = false -%}\n        {%- for p in people -%}\n          {%- assign bits = p | split: '|' -%}\n          {%- assign pn = bits[0] | strip | plus: 0 -%}\n          {%- if pn == n -%}{%- assign taken = true -%}{%- assign who = bits[1] | strip -%}{%- assign town = bits[2] | strip -%}{%- endif -%}\n        {%- endfor -%}\n        {%- assign is_held = false -%}\n        {%- for h in held -%}{%- assign hn = h | strip | plus: 0 -%}{%- if hn == n and hn > 0 -%}{%- assign is_held = true -%}{%- endif -%}{%- endfor -%}\n        <li{% if is_held and taken == false %} class=\"res\"{% endif %}{% if taken %} class=\"on\" aria-label=\"Number {{ num }}, claimed\"{% endif %} data-n=\"{{ num }}\"><b>{{ num }}</b>{% if taken %}<i>Claimed</i>{% endif %}</li>\n      {%- endfor -%}\n    </ul>\n    <div class=\"sn-bub\" id=\"snBub\" hidden><strong></strong><span></span><button type=\"button\" hidden>Claim this number</button></div>\n    </div>\n    <p class=\"sn-cap\" id=\"snCap\">Tap a number to see if it's available.</p>\n\n    <div class=\"sn-claim\" id=\"snClosed\" hidden>\n      <h3>Claims are closed</h3>\n      <p id=\"snClosedText\">Satomi Supporters closed with {{ count }} members. Thank you to every one of you.</p>\n    </div>\n\n    <div class=\"sn-claim\" id=\"snClaim\">\n      {%- form 'contact', id: 'snSupForm' -%}\n        {%- if form.posted_successfully? -%}\n          <div class=\"sn-done\" data-posted=\"1\">\n            <div class=\"sn-seal\">里</div>\n            <h3>Claim received</h3>\n            <p>Thank you. I'll check your number against the WhatsApp group and message you there with your Supporter number.</p>\n          </div>\n        {%- else -%}\n          <h3>Claim your number</h3>\n          <p>Takes a minute. Tap a number on the wall to pick your own, or leave it and I'll give you the next one available.</p>\n          {%- if form.errors -%}\n            <div class=\"sn-err\" data-errors=\"1\">Something's not quite right: {{ form.errors | default_errors }}</div>\n          {%- endif -%}\n          <input type=\"hidden\" name=\"contact[Subject]\" value=\"Satomi Supporter claim\">\n          <label>Your number</label>\n          <input type=\"hidden\" id=\"snWant\" name=\"contact[Number wanted]\" value=\"Next one available\">\n          <div class=\"sn-picked\" id=\"snPicked\"><span id=\"snPickedText\">I'll give you the next one available</span><a id=\"snPickedClear\" hidden>change</a></div>\n          <label for=\"snName\">Your name</label>\n          <input id=\"snName\" type=\"text\" name=\"contact[name]\" autocomplete=\"name\" required>\n          <label for=\"snPhone\">Your WhatsApp number <small>(the one you use in the group)</small></label>\n          <input id=\"snPhone\" type=\"tel\" name=\"contact[WhatsApp number]\" autocomplete=\"tel\" inputmode=\"tel\" required>\n          <label for=\"snEmail\">Your email <small>(for your Supporter login, never for marketing)</small></label>\n          <input id=\"snEmail\" type=\"email\" name=\"contact[email]\" autocomplete=\"email\" spellcheck=\"false\" autocapitalize=\"off\" required>\n          <input type=\"hidden\" name=\"contact[body]\" value=\"Satomi Supporter claim\">\n          <button type=\"submit\">Claim my number</button>\n          <p class=\"sn-note\">Your number is only used to check you're in the group. It's never shared and never used for marketing.</p>\n        {%- endif -%}\n      {%- endform -%}\n    </div>\n\n    <p class=\"sn-small\">One per person, tied to your WhatsApp number, and not transferable. Your discount code is personal: it's only for koi delivered to your own address, and if it's shared it can be withdrawn. Claims are open for two weeks or until all {{ total }} numbers are gone, whichever comes first. Then Satomi Supporters closes for good.</p>\n  </div>\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('snSup'); if (!root) return;\n  if (root.parentElement) root.parentElement.style.padding = '0';\n  var band = root.closest('.gradient'); if (band) band.style.background = '#000';\n\n  function $(id){ return document.getElementById(id); }\n  var closeAt = new Date(root.getAttribute('data-close'));\n  var count = +root.getAttribute('data-count'), total = +root.getAttribute('data-total');\n  var q = new URLSearchParams(location.search);\n  var posted = !!root.querySelector('[data-posted]') || q.get('contact_posted') === 'true';\n  var errors = !!root.querySelector('[data-errors]');\n\n  function isClosed(){ return count >= total || isNaN(closeAt) || Date.now() >= closeAt.getTime(); }\n\n  function show(){\n    var closed = isClosed();\n    root.classList.toggle('is-closed', closed);\n    $('snClosed').hidden = !closed || posted;\n    $('snClaim').hidden = !(posted || errors || !closed);\n    if (closed){\n      var when = count >= total ? 'with all ' + total + ' numbers claimed' :\n        'on ' + closeAt.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' }) + ' with ' + count + ' members';\n      $('snClosedText').textContent = 'Satomi Supporters closed ' + when + '. Thank you to every one of you.';\n    }\n    return closed;\n  }\n\n  // If the form was just sent, the page reloads at the top. Jump back down to the thank-you.\n  if (posted || errors){ setTimeout(function(){ $('snClaim').scrollIntoView({ block:'center' }); }, 300); }\n\n  // Countdown to claims closing\n  var clock = $('snSupClock'), num = clock.querySelector('b'), lbl = clock.querySelector('span');\n  function tick(){\n    if (show()){ clock.classList.add('closed'); num.textContent = 'Closed'; lbl.textContent = 'for good'; return false; }\n    var t = closeAt.getTime() - Date.now();\n    var d = Math.floor(t/864e5), h = Math.floor(t/36e5)%24, m = Math.floor(t/6e4)%60, s = Math.floor(t/1e3)%60;\n    num.textContent = d > 0 ? d + 'd ' + h + 'h ' + m + 'm' : h + 'h ' + m + 'm ' + s + 's';\n    return true;\n  }\n  if (tick()){ var iv = setInterval(function(){ if (!tick()) clearInterval(iv); }, 1000); }\n\n  // Tap a tile: pop up a label on it saying who it belongs to\n  var cap = $('snCap'), bub = $('snBub'), wrap = $('snWallWrap'), last, hideT;\n  function hideBub(){ bub.hidden = true; if (last){ last.classList.remove('sel'); last = null; } }\n  $('snWall').addEventListener('click', function(e){\n    var li = e.target.closest('li'); if (!li || li.classList.contains('on')) return;\n    e.stopPropagation();\n    if (last === li){ hideBub(); return; }\n    if (last) last.classList.remove('sel'); li.classList.add('sel'); last = li;\n    var n = li.getAttribute('data-n');\n    var res = li.classList.contains('res');\n    var who = res ? 'Not available' : li.classList.contains('on') ? (li.getAttribute('data-who') ? 'Taken by ' + li.getAttribute('data-who') : 'Taken by a Satomi Supporter') :\n      (isClosed() ? 'Never claimed' : 'Still to be claimed. Want it?');\n    var btn = bub.querySelector('button');\n    btn.hidden = !(canClaim() && !li.classList.contains('on') && !res);\n    btn.setAttribute('data-n', n);\n    bub.querySelector('strong').textContent = 'No. ' + n;\n    bub.querySelector('span').textContent = who;\n    cap.innerHTML = ''; var s = document.createElement('strong'); s.textContent = 'No. ' + n; cap.appendChild(s);\n    cap.appendChild(document.createTextNode(' · ' + who));\n    // place it above the tile (or below if it's on the top row), kept inside the wall\n    var W = wrap.clientWidth, cx = li.offsetLeft + li.offsetWidth/2;\n    bub.hidden = false;\n    var bw = bub.offsetWidth/2, x = Math.max(bw, Math.min(W - bw, cx));\n    var below = li.offsetTop < 70;\n    bub.classList.toggle('below', below);\n    bub.style.left = x + 'px';\n    bub.style.top = (below ? li.offsetTop + li.offsetHeight : li.offsetTop) + 'px';\n    bub.style.setProperty('--ax', (50 + (cx - x) / (bw*2) * 100) + '%');\n    bub.style.animation = 'none'; void bub.offsetWidth; bub.style.animation = '';\n    clearTimeout(hideT); hideT = setTimeout(hideBub, btn.hidden ? 4000 : 9000);\n  });\n  document.addEventListener('click', function(e){ if (!bub.hidden && !e.target.closest('#snWall') && !e.target.closest('#snBub')) hideBub(); });\n\n  // \"Claim this number\": put the number in the form and take them to it\n  function canClaim(){ return !!$('snWant') && !$('snClaim').hidden && !isClosed(); }\n  bub.querySelector('button').addEventListener('click', function(e){\n    e.stopPropagation();\n    var n = this.getAttribute('data-n');\n    $('snWant').value = 'No. ' + n;\n    $('snPickedText').innerHTML = 'You picked <b>No. ' + n + '</b>';\n    $('snPickedClear').hidden = false;\n    hideBub();\n    var box = $('snClaim'); box.scrollIntoView({ behavior:'smooth', block:'start' });\n    box.classList.remove('flash'); void box.offsetWidth; box.classList.add('flash');\n    setTimeout(function(){ var nm = $('snName'); if (nm && !nm.value) nm.focus({ preventScroll:true }); }, 700);\n  });\n  var clr = $('snPickedClear');\n  if (clr){ clr.addEventListener('click', function(){ $('snWant').value = 'Next one available'; $('snPickedText').textContent = \"I'll give you the next one available\"; clr.hidden = true; }); }\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
  },
  "order": [
    "main",
    "custom_liquid_CQeGmr",
    "custom_liquid_fehm8a",
    "custom_liquid_rLBdVf"
  ]
}
