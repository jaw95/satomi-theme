{% comment %}
  SATOMI NISHIKIGOI · HALLOWEEN PUMPKINS
  Theme section file (sections/satomi-pumpkins.liquid), in the header group so it's on every page.
  Three glowing jack-o'-lanterns sit in the bottom-left corner, candles flickering. Tap one and it flares up.
  They only show between the two dates below (UK time), so they come back by themselves next year.
  Preview any time by adding ?pumpkins=1 to the end of the address.
{% endcomment %}
{%- assign show_from = section.settings.show_from | default: '10-18' -%}
{%- assign show_until = section.settings.show_until | default: '11-01' -%}
<style>
  #snPumpkins{position:fixed;left:14px;bottom:10px;z-index:41;display:none;align-items:flex-end;gap:2px;pointer-events:none}
  #snPumpkins.on{display:flex}
  #snPumpkins svg{display:block !important;pointer-events:auto;cursor:pointer;overflow:visible;filter:drop-shadow(0 4px 6px rgba(0,0,0,.6));transform-origin:50% 100%;transition:transform .25s}
  #snPumpkins svg + svg{margin-left:-12px}
  #snPumpkins svg:hover{transform:scale(1.06) rotate(-2deg)}
  #snPumpkins .glow{animation:snFlicker 2.2s infinite steps(1,end)}
  #snPumpkins svg:nth-child(2) .glow{animation-duration:1.7s;animation-delay:-.6s}
  #snPumpkins svg:nth-child(3) .glow{animation-duration:2.6s;animation-delay:-1.1s}
  #snPumpkins .halo{opacity:.7;animation:snHalo 2.2s ease-in-out infinite alternate}
  #snPumpkins svg.lit .glow{fill:#fff3b0}
  #snPumpkins svg.lit .halo{opacity:1}
  #snPumpkins svg.lit{animation:snWobble .6s ease-in-out}
  @keyframes snFlicker{0%{opacity:1}12%{opacity:.82}20%{opacity:1}47%{opacity:.9}55%{opacity:.7}60%{opacity:1}83%{opacity:.86}}
  @keyframes snHalo{from{opacity:.45}to{opacity:.85}}
  @keyframes snWobble{0%,100%{transform:rotate(0)}25%{transform:rotate(-6deg)}75%{transform:rotate(5deg)}}
  @media (max-width:600px){#snPumpkins{left:8px;bottom:8px} #snPumpkins svg{transform:scale(.78)} }
  @media (prefers-reduced-motion:reduce){#snPumpkins .glow,#snPumpkins .halo{animation:none}}
</style>
{%- capture pumpkin -%}
<svg viewBox="-52 -64 104 108" width="WIDTH" height="HEIGHT" aria-hidden="true">
  <defs>
    <radialGradient id="pkB-ID" cx="45%" cy="38%" r="70%"><stop offset="0" stop-color="#ffab3d"/><stop offset=".55" stop-color="#e8661a"/><stop offset="1" stop-color="#8a2d06"/></radialGradient>
    <radialGradient id="pkH-ID"><stop offset="0" stop-color="rgba(255,190,60,.9)"/><stop offset="1" stop-color="rgba(255,120,20,0)"/></radialGradient>
  </defs>
  <ellipse class="halo" cx="0" cy="8" rx="62" ry="46" fill="url(#pkH-ID)"/>
  <path d="M-2 -38 C-3 -50 2 -58 10 -62 L13 -57 C7 -53 5 -47 6 -38 Z" fill="#4b6b23"/>
  <path d="M8 -55 C16 -62 26 -60 30 -54" fill="none" stroke="#5f8a2a" stroke-width="3" stroke-linecap="round"/>
  <ellipse cx="-26" cy="4" rx="24" ry="38" fill="url(#pkB-ID)"/>
  <ellipse cx="26" cy="4" rx="24" ry="38" fill="url(#pkB-ID)"/>
  <ellipse cx="-12" cy="2" rx="22" ry="41" fill="url(#pkB-ID)"/>
  <ellipse cx="12" cy="2" rx="22" ry="41" fill="url(#pkB-ID)"/>
  <ellipse cx="0" cy="1" rx="19" ry="42" fill="url(#pkB-ID)"/>
  <g class="glow" fill="#ffd34d">
    <path d="M-27 -10 L-9 -10 L-18 -28 Z"/>
    <path d="M9 -10 L27 -10 L18 -28 Z"/>
    <path d="M-4 -2 L4 -2 L0 -10 Z"/>
    <path d="M-31 6 Q0 40 31 6 L24 9 L19 17 L12 11 L6 21 L0 13 L-6 21 L-12 11 L-19 17 L-24 9 Z"/>
  </g>
</svg>
{%- endcapture -%}
<div id="snPumpkins" data-from="{{ show_from }}" data-until="{{ show_until }}" title="Happy Halloween from Satomi">
  {{ pumpkin | replace: 'WIDTH', '58' | replace: 'HEIGHT', '58' | replace: '-ID', '-a' }}
  {{ pumpkin | replace: 'WIDTH', '84' | replace: 'HEIGHT', '84' | replace: '-ID', '-b' }}
  {{ pumpkin | replace: 'WIDTH', '46' | replace: 'HEIGHT', '46' | replace: '-ID', '-c' }}
</div>
<script>
(function(){
  var box = document.getElementById('snPumpkins'); if (!box || box.__done) return; box.__done = true;
  var sec = box.closest('.shopify-section'); if (sec){ sec.style.height = '0'; sec.style.overflow = 'visible'; }
  // UK date as MM-DD
  var p = {}; new Intl.DateTimeFormat('en-GB', { timeZone:'Europe/London', month:'2-digit', day:'2-digit' }).formatToParts(new Date()).forEach(function(x){ p[x.type] = x.value; });
  var today = p.month + '-' + p.day, from = box.getAttribute('data-from'), until = box.getAttribute('data-until');
  var inWindow = from <= until ? (today >= from && today <= until) : (today >= from || today <= until);
  if (!inWindow && !/[?&]pumpkins=1/.test(location.search)) return;
  box.classList.add('on');
  box.querySelectorAll('svg').forEach(function(s){
    s.addEventListener('click', function(){ s.classList.remove('lit'); void s.offsetWidth; s.classList.add('lit'); setTimeout(function(){ s.classList.remove('lit'); }, 1800); });
  });
})();
</script>

{% schema %}
{
  "name": "Satomi: Pumpkins",
  "settings": [
    { "type": "text", "id": "show_from", "label": "Show from (month-day)", "default": "10-18" },
    { "type": "text", "id": "show_until", "label": "Show until (month-day)", "default": "11-01" }
  ]
}
{% endschema %}
