{% comment %}
  SATOMI NISHIKIGOI · JACKPOT BANNER (normal koi product pages)
  Theme section file (sections/satomi-jackpot-banner.liquid), placed just above "Product information"
  on the default product template of Satomi 2027. Claude updates it through the Shopify connector.
  It only shows on a koi whose "Jackpot for wheel" box is filled in. Every other koi page is untouched.
    - Before the first spot sells: says this koi is also the jackpot on Wheel XX, and links to it.
    - After the first spot sells: says it's locked to the Wheel, and hides the buy buttons.
{% endcomment %}
{%- assign wheel = product.metafields.custom.jackpot_for_wheel.value -%}
{%- if wheel != blank -%}
  {%- assign w_taken = 0 -%}{%- assign w_price = 0 -%}
  {%- for v in wheel.variants -%}
    {%- unless v.available -%}{%- assign w_taken = w_taken | plus: 1 -%}{%- endunless -%}
    {%- if v.price > 0 and w_price == 0 -%}{%- assign w_price = v.price -%}{%- endif -%}
  {%- endfor -%}
  {%- assign w_left = wheel.variants.size | minus: w_taken -%}

  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&family=EB+Garamond:wght@400&display=swap" rel="stylesheet">
  <style>
    .sjb{--w:#f5f3ef;--g:#a3a09b;--r:#d70f0f;--glow:#f91e11;font-family:'EB Garamond',Georgia,serif;color:var(--w);
      max-width:1100px;margin:0 auto;padding:18px 16px 0;box-sizing:border-box}
    .sjb *{box-sizing:border-box}
    .sjb-in{display:flex;gap:18px;align-items:center;justify-content:space-between;flex-wrap:wrap;
      background:#0b0b0b;border:1px solid rgba(245,243,239,.14);border-left:3px solid var(--r);border-radius:4px;padding:16px 18px}
    .sjb.locked .sjb-in{background:rgba(215,15,15,.09);border-color:rgba(215,15,15,.55);border-left-color:var(--glow)}
    .sjb-txt{flex:1 1 320px;min-width:0}
    .sjb small{display:block;font-family:'Cinzel',serif;font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--glow);margin:0 0 4px}
    .sjb b{display:block;font-family:'Cinzel',serif;font-weight:600;font-size:18px;letter-spacing:.04em;margin:0 0 4px;line-height:1.25}
    .sjb p{font-size:16px;line-height:1.5;color:var(--g);margin:0}
    .sjb a{flex:0 0 auto;font-family:'Cinzel',serif;font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;
      background:var(--r);color:#fff;border-radius:3px;padding:12px 16px;box-shadow:0 0 16px rgba(215,15,15,.35)}
    .sjb a:hover{background:var(--glow)}
    {%- if w_taken > 0 %}
    /* locked: stop this koi being bought here */
    product-form, .product-form, .product-form__buttons, .shopify-payment-button, .product-form__quantity, quantity-input,
    form[action*="/cart/add"] [type="submit"]{display:none !important}
    {%- endif %}
  </style>

  <div class="sjb{% if w_taken > 0 %} locked{% endif %}">
    <div class="sjb-in">
      <div class="sjb-txt">
        {%- if w_taken > 0 -%}
          <small>Koi Roulette · {{ wheel.title }}</small>
          <b>🔒 Locked to {{ wheel.title }}</b>
          <p>This koi is the jackpot, and the first spot has sold, so it can't be bought here any more. {% if w_left > 0 %}{{ w_left }} spot{% if w_left != 1 %}s{% endif %} left at {{ w_price | money_without_trailing_zeros }}.{% else %}The board's full and the spin is coming up.{% endif %}</p>
        {%- else -%}
          <small>Koi Roulette · {{ wheel.title }}</small>
          <b>This koi is also the jackpot on {{ wheel.title }}</b>
          <p>Buy it outright here, or take a spot for {{ w_price | money_without_trailing_zeros }} and try to win it. The first spot sold locks it to the Wheel, and it comes out of the shop.</p>
        {%- endif -%}
      </div>
      {%- if w_left > 0 -%}<a href="{{ wheel.url }}">See the Wheel</a>{%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Satomi: Jackpot banner",
  "settings": []
}
{% endschema %}
