{% comment %}
  SATOMI NISHIKIGOI · SUPPORTERS PAGE: AUTUMN GROW-ON HARVEST KOI
  Theme section file (sections/satomi-supporters-harvest.liquid), on the Supporters page under the main Supporters section.
  Only logged-in Supporters see it (customer tag "supporter"). Everyone else sees nothing here.
  Shows every koi in the collection set below (default harvest-2026, which fills itself from the harvest-2026 tag):
  photo, card number (SKU), breeder, variety, age, size, sex, the normal price and the Supporter price (25% off),
  how long the 24-hour head start has left, and "Sold" once a fish has gone.
  Before the first harvest koi is listed it shows the holding message instead.
{% endcomment %}
{%- assign is_sup = false -%}
{%- if customer and customer.tags contains 'supporter' -%}{%- assign is_sup = true -%}{%- endif -%}
{%- if is_sup -%}
{%- assign coll = collections[section.settings.collection_handle] -%}
{%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
{%- assign total = 0 -%}{%- assign left = 0 -%}
{%- if coll != blank -%}{%- for p in coll.products -%}{%- assign total = total | plus: 1 -%}{%- if p.available -%}{%- assign left = left | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- endif -%}
<style>
  .ssh{--w:#f5f3ef;--g:#a3a09b;--r:#d70f0f;--glow:#f91e11;--edge:rgba(245,243,239,.14);
    background:#000;color:var(--w);font-family:'EB Garamond',Georgia,serif;padding:0 16px 72px;box-sizing:border-box}
  .ssh *{box-sizing:border-box}
  .ssh-in{max-width:1100px;margin:0 auto;border-top:1px solid var(--edge);padding-top:48px}
  .ssh-kick{font-family:'Cinzel',serif;font-size:12px;letter-spacing:.32em;text-transform:uppercase;color:var(--r);text-align:center;margin:0 0 10px}
  .ssh-kick b{font-family:'Noto Serif JP',serif;font-weight:600;letter-spacing:.1em;margin-left:6px}
  .ssh h2{font-family:'Cinzel',serif;font-weight:600;letter-spacing:.05em;font-size:clamp(24px,4.4vw,36px);line-height:1.15;text-align:center;margin:0 0 10px}
  .ssh-lede{text-align:center;font-size:19px;line-height:1.5;color:var(--g);max-width:34em;margin:0 auto 24px}
  .ssh-lede b{color:var(--w);font-weight:500}
  .ssh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
  .ssh-card{position:relative;display:flex;flex-direction:column;background:#0b0b0b;border:1px solid var(--edge);border-top:2px solid var(--r);border-radius:4px;overflow:hidden}
  .ssh-pic{position:relative;display:block;aspect-ratio:3/4;overflow:hidden;background:#0b0b0b}
  .ssh-pic img{width:100%;height:100%;object-fit:contain;display:block}
  .ssh-no{position:absolute;top:10px;left:10px;font-family:'Cinzel',serif;font-size:11px;letter-spacing:.14em;background:rgba(0,0,0,.75);border:1px solid var(--edge);border-radius:3px;padding:4px 7px}
  .ssh-early{position:absolute;top:10px;right:10px;font-family:'Cinzel',serif;font-size:10px;letter-spacing:.14em;text-transform:uppercase;background:var(--r);color:#fff;border-radius:3px;padding:4px 7px}
  .ssh-body{display:flex;flex-direction:column;gap:6px;padding:12px 14px 14px;flex:1}
  .ssh-body small{font-family:'Cinzel',serif;font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--r)}
  .ssh-body h3{margin:0;font-family:'Cinzel',serif;font-weight:600;font-size:19px;letter-spacing:.03em;line-height:1.2}
  .ssh-body h3 a{color:var(--w);text-decoration:none}
  .ssh-facts{display:flex;flex-wrap:wrap;gap:5px;margin:2px 0 0;padding:0;list-style:none}
  .ssh-facts li{padding:3px 9px;border:1px solid rgba(245,243,239,.2);border-radius:99px;font-size:14px}
  .ssh-price{margin-top:auto;padding-top:6px;font-family:'Cinzel',serif;font-weight:700;font-size:22px;color:#fff}
  .ssh-price s{font-family:'EB Garamond',Georgia,serif;font-weight:400;font-size:16px;color:var(--g);margin-right:6px}
  .ssh-price small{display:block;font-family:'EB Garamond',Georgia,serif;font-weight:400;font-size:14px;letter-spacing:0;text-transform:none;color:var(--g)}
  .ssh-buy{all:unset;box-sizing:border-box;display:block;text-align:center;cursor:pointer;margin-top:6px;padding:12px;border-radius:3px;background:var(--r);color:#fff;
    font-family:'Cinzel',serif;font-weight:700;font-size:12px;letter-spacing:.16em;text-transform:uppercase;box-shadow:0 0 14px rgba(215,15,15,.3)}
  .ssh-buy:hover{background:var(--glow)}
  .ssh-card.sold .ssh-pic img{filter:grayscale(.85) brightness(.55)}
  .ssh-sold{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(-8deg);padding:8px 16px;border:3px solid #c8102e;border-radius:4px;
    font-family:'Cinzel',serif;font-weight:700;font-size:22px;letter-spacing:.2em;text-transform:uppercase;color:#fff;background:rgba(200,16,46,.35)}
  .ssh-gone{margin-top:auto;padding-top:6px;font-size:16px;font-style:italic;color:var(--g)}
  .ssh-wait{max-width:620px;margin:0 auto;text-align:center;background:#0b0b0b;border:1px solid var(--edge);border-top:2px solid var(--r);border-radius:4px;padding:28px 22px}
  .ssh-wait b{display:block;font-family:'Noto Serif JP',serif;font-size:40px;line-height:1;color:#fff;text-shadow:0 0 18px rgba(249,30,17,.5);margin-bottom:12px}
  .ssh-wait p{font-size:18px;line-height:1.55;color:var(--g);margin:0}
  .ssh-note{text-align:center;font-size:16px;color:var(--g);margin:20px auto 0;max-width:38em;font-style:italic}
  @media (max-width:520px){ .ssh-grid{grid-template-columns:1fr 1fr;gap:10px} .ssh-body{padding:10px} .ssh-body h3{font-size:16px} .ssh-facts li{font-size:12px;padding:2px 7px} .ssh-price{font-size:18px} .ssh-buy{font-size:11px;letter-spacing:.1em;padding:10px 6px} }
</style>

<section class="ssh" id="ssh-{{ section.id }}">
  <div class="ssh-in">
    <p class="ssh-kick">{{ section.settings.kicker }} <b>収穫</b></p>
    <h2>{{ section.settings.heading }}</h2>

    {%- if total == 0 -%}
      <div class="ssh-wait">
        <b>錦鯉</b>
        <p>{{ section.settings.empty_text }}</p>
      </div>
    {%- else -%}
      <p class="ssh-lede"><b>{{ total }}</b> koi out of the pond · <b>{{ left }}</b> still looking for a home. Your Supporter price is shown on every fish and comes off by itself in the basket.</p>
      <div class="ssh-grid">
        {%- for pass in (1..2) -%}
        {%- for p in coll.products -%}
          {%- if pass == 1 and p.available == false -%}{%- continue -%}{%- endif -%}
          {%- if pass == 2 and p.available -%}{%- continue -%}{%- endif -%}
          {%- assign k = p.metafields.koi -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          {%- assign variety = k.variety.value | default: p.title -%}
          {%- assign sex = k.sex.value | default: '' -%}
          {%- assign pf = k.public_from.value -%}{%- assign early = false -%}
          {%- if pf != blank -%}{%- assign pf_s = pf | date: '%s' | plus: 0 -%}{%- if pf_s > now_s -%}{%- assign early = true -%}{%- endif -%}{%- endif -%}
          <article class="ssh-card{% unless p.available %} sold{% endunless %}">
            <a class="ssh-pic" href="{{ p.url }}">
              {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.vendor | escape }} {{ variety | escape }}" loading="lazy" width="600" height="800">{%- endif -%}
              {%- if v.sku != blank -%}<span class="ssh-no">{{ v.sku }}</span>{%- endif -%}
              {%- if early and p.available -%}<span class="ssh-early">Supporters only</span>{%- endif -%}
              {%- unless p.available -%}<span class="ssh-sold">Sold</span>{%- endunless -%}
            </a>
            <div class="ssh-body">
              <small>{{ p.vendor }}</small>
              <h3><a href="{{ p.url }}">{{ variety }}</a></h3>
              <ul class="ssh-facts">
                {%- if k.age.value != blank -%}<li>{{ k.age.value }}</li>{%- endif -%}
                {%- if k.size_cm.value -%}<li>{{ k.size_cm.value }}cm</li>{%- endif -%}
                {%- if sex != '' and sex != 'Unknown' -%}<li>{{ sex }}</li>{%- endif -%}
              </ul>
              {%- if p.available -%}
                <div class="ssh-price"><s>{{ v.price | money_without_trailing_zeros }}</s>{{ v.price | times: 0.75 | round | money_without_trailing_zeros }}
                  <small>{% if early %}Yours first · everyone else from {{ pf | date: '%a %-d %b, %-I%P' }}{% else %}Your Supporter price{% endif %}</small></div>
                <form method="post" action="/cart/add" class="ssh-form">
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="ssh-buy">Buy this koi</button>
                </form>
              {%- else -%}
                <div class="ssh-gone">Gone to a new home</div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}<p class="ssh-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('ssh-{{ section.id }}'); if (!root) return;
  var sec = root.closest('.shopify-section'); if (sec) sec.style.padding = '0';
  var band = root.closest('.gradient'); if (band) band.style.background = '#000';
  // "Buy this koi": add the fish, then go to the basket (the Supporter code goes on by itself there)
  root.querySelectorAll('.ssh-form').forEach(function(f){
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = f.querySelector('button'); if (btn.disabled) return;
      btn.disabled = true; btn.textContent = 'Adding…';
      fetch('/cart/add.js', { method:'POST', headers:{ 'Accept':'application/json' }, body: new FormData(f) })
        .catch(function(){}).then(function(){ window.location.href = '/cart'; });
    });
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Satomi: Supporter harvest",
  "settings": [
    { "type": "text", "id": "collection_handle", "label": "Collection handle", "default": "harvest-2026" },
    { "type": "text", "id": "kicker", "label": "Small line above", "default": "Supporters · Harvest 2026" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Autumn Grow-on Harvest Koi" },
    { "type": "textarea", "id": "empty_text", "label": "Message before the koi are listed", "default": "Harvest day is Sunday 8 November. Every koi out of the pond lands here first, with your Supporter price, 24 hours before anyone else can buy it." },
    { "type": "text", "id": "note", "label": "Note under the grid", "default": "Every koi is grown on here at 24°C and ready from March 2027, or collect yours on Opening Day. The price includes growing on till then." }
  ],
  "presets": [{ "name": "Satomi: Supporter harvest" }]
}
{% endschema %}
