        "custom_liquid": "{% comment %}\n  SATOMI NISHIKIGOI — SEASONS + MUSIC\n  Paste into a \"Custom liquid\" section. It shows on the whole screen, so position doesn't matter.\n    - Coming soon (live theme): add it on the Password page.\n    - Satomi 2027: add it in the Footer area, so it's on every page.\n\n  The lines below are all you'll ever change:\n    season   'auto' picks from the date (Mar-May spring, Jun-Aug summer, Sep-Nov autumn, Dec-Feb winter)\n             or force one: 'spring', 'summer', 'autumn', 'winter'\n    amount   how much falls: 'light', 'normal' or 'heavy'\n  To preview a season on the website, add ?season=winter (or spring, summer, autumn) to the end of the address.\n{% endcomment %}\n{%- assign season = 'auto' -%}\n{%- assign amount = 'light' -%}\n\n<style>\n  #snAtmos{position:fixed; inset:0; width:100vw; height:100vh; pointer-events:none; z-index:40; display:block !important}\n  #snAtmosTint{position:fixed; inset:0; pointer-events:none; z-index:39; display:block !important; opacity:0; transition:opacity 2s}\n  #snAtmosTint.winter{opacity:1; background:\n    radial-gradient(ellipse 40% 35% at 0 0, rgba(210,228,255,.10), transparent 70%),\n    radial-gradient(ellipse 40% 35% at 100% 0, rgba(210,228,255,.10), transparent 70%),\n    radial-gradient(ellipse 60% 25% at 50% 100%, rgba(210,228,255,.08), transparent 70%)}\n  #snAtmosTint.summer{opacity:1; background:radial-gradient(ellipse 70% 55% at 100% 0, rgba(255,120,40,.10), transparent 70%)}\n  #snAtmos.summer{mix-blend-mode:screen}\n  #snAtmosTint.autumn{opacity:1; background:radial-gradient(ellipse 90% 30% at 50% 100%, rgba(160,40,10,.10), transparent 75%)}\n  #snAtmosTint.spring{opacity:1; background:radial-gradient(ellipse 80% 30% at 50% 0, rgba(255,190,205,.06), transparent 75%)}\n  .sn-amb{position:fixed; right:16px; bottom:16px; z-index:41; display:flex !important; align-items:center; gap:0; border-radius:99px;\n    background:rgba(10,10,10,.82); border:1px solid rgba(245,243,239,.18); box-shadow:0 4px 18px rgba(0,0,0,.5); backdrop-filter:blur(6px);\n    -webkit-backdrop-filter:blur(6px); font-family:'Cinzel',Georgia,serif; color:#f5f3ef; overflow:hidden}\n  .sn-amb-season{display:flex; align-items:center; gap:8px; padding:8px 12px 8px 10px; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:#a3a09b; white-space:nowrap}\n  .sn-amb-season b{font-family:'Noto Serif JP',serif; font-weight:600; font-size:17px; letter-spacing:0; color:#e0201a; line-height:1}\n  .sn-amb button{all:unset; box-sizing:border-box; cursor:pointer; display:flex; align-items:center; gap:8px; padding:8px 14px 8px 12px;\n    border-left:1px solid rgba(245,243,239,.14); font-family:'Cinzel',Georgia,serif; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:#f5f3ef}\n  .sn-amb button:hover{background:rgba(215,15,15,.18)}\n  .sn-amb button:focus-visible{outline:2px solid #f91e11; outline-offset:-2px}\n  .sn-amb svg{width:18px; height:18px; display:block !important; flex:0 0 auto}\n  .sn-amb .wave{opacity:0; transition:opacity .3s}\n  .sn-amb.on .wave{opacity:1}\n  .sn-amb.on button{color:#fff; background:rgba(215,15,15,.28)}\n  .sn-amb .x{transition:opacity .3s}\n  .sn-amb.on .x{opacity:0}\n  @media (max-width:600px){ .sn-amb-season span{display:none} .sn-amb{right:12px; bottom:12px} }\n</style>\n\n<div id=\"snAtmosTint\" aria-hidden=\"true\"></div>\n<canvas id=\"snAtmos\" aria-hidden=\"true\" data-season=\"{{ season | escape }}\" data-amount=\"{{ amount | escape }}\"></canvas>\n<div class=\"sn-amb\" id=\"snAmb\">\n  <div class=\"sn-amb-season\" id=\"snAmbSeason\"><b>秋</b><span>Autumn</span></div>\n  <button type=\"button\" id=\"snAmbBtn\" aria-pressed=\"false\" aria-label=\"Turn the music on\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M4 9v6h4l5 4V5L8 9H4z\" fill=\"currentColor\" stroke=\"none\"/>\n      <path class=\"wave\" d=\"M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12\"/>\n      <path class=\"x\" d=\"M17 9.5l5 5M22 9.5l-5 5\"/>\n    </svg>\n    <span>Music</span>\n  </button>\n</div>\n\n<script>\n(function(){\n  if (window.__snAtmos) return; window.__snAtmos = true;\n  var cv = document.getElementById('snAtmos'); if (!cv) return;\n  var sec = cv.closest('.shopify-section'); if (sec){ sec.style.height = '0'; sec.style.overflow = 'visible'; var pad = cv.parentElement; if (pad && pad !== sec) pad.style.padding = '0'; }\n  document.querySelectorAll('.sn-petals').forEach(function(el){ el.style.display = 'none'; });\n\n  /* ================= which season ================= */\n  var SEASONS = { spring:{ jp:'春', en:'Spring' }, summer:{ jp:'夏', en:'Summer' }, autumn:{ jp:'秋', en:'Autumn' }, winter:{ jp:'冬', en:'Winter' } };\n  var s = (cv.getAttribute('data-season') || 'auto').toLowerCase();\n  var force = (location.search.match(/[?&]season=(\\w+)/) || [])[1]; if (force && SEASONS[force]) s = force;\n  if (!SEASONS[s]){ var mo = new Date().getMonth(); s = mo >= 2 && mo <= 4 ? 'spring' : mo >= 5 && mo <= 7 ? 'summer' : mo >= 8 && mo <= 10 ? 'autumn' : 'winter'; }\n  var badge = document.getElementById('snAmbSeason');\n  badge.querySelector('b').textContent = SEASONS[s].jp; badge.querySelector('span').textContent = SEASONS[s].en; badge.title = SEASONS[s].en + ' at Satomi';\n  document.getElementById('snAtmosTint').className = s;\n\n  /* ================= set up ================= */\n  var ctx = cv.getContext('2d'), W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);\n  function size(){ W = window.innerWidth; H = window.innerHeight; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }\n  size(); window.addEventListener('resize', size);\n  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var small = W < 700;\n  var amt = { light:.55, normal:1, heavy:1.7 }[cv.getAttribute('data-amount')] || 1;\n  var rnd = function(a, b){ return a + Math.random() * (b - a); };\n  var pick = function(a){ return a[Math.floor(Math.random() * a.length)]; };\n\n  /* ---------- pre-drawn sprites (fast, and soft ones for depth) ---------- */\n  var canBlur = 'filter' in ctx;\n  function sprite(sz, draw, blur){\n    var c = document.createElement('canvas'), pad = blur ? blur * 3 : 2; c.width = c.height = sz + pad * 2;\n    var x = c.getContext('2d'); if (blur && canBlur) x.filter = 'blur(' + blur + 'px)';\n    x.translate(c.width / 2, c.height / 2); draw(x, sz / 2); return c;\n  }\n  function drawFlake(x, r){ var g = x.createRadialGradient(0, 0, 0, 0, 0, r); g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(.45, 'rgba(255,255,255,.85)'); g.addColorStop(1, 'rgba(255,255,255,0)'); x.fillStyle = g; x.beginPath(); x.arc(0, 0, r, 0, 6.29); x.fill(); }\n  function drawCrystal(x, r){ x.strokeStyle = 'rgba(240,246,255,.95)'; x.lineWidth = r * .09; x.lineCap = 'round';\n    for (var i = 0; i < 6; i++){ x.save(); x.rotate(i * Math.PI / 3); x.beginPath(); x.moveTo(0, 0); x.lineTo(0, -r * .92);\n      x.moveTo(0, -r * .5); x.lineTo(r * .22, -r * .68); x.moveTo(0, -r * .5); x.lineTo(-r * .22, -r * .68);\n      x.moveTo(0, -r * .26); x.lineTo(r * .14, -r * .38); x.moveTo(0, -r * .26); x.lineTo(-r * .14, -r * .38); x.stroke(); x.restore(); }\n    x.fillStyle = 'rgba(255,255,255,.9)'; x.beginPath(); x.arc(0, 0, r * .1, 0, 6.29); x.fill(); }\n  function drawMaple(col){ return function(x, r){\n    var pts = [[0,-1],[.2,-.5],[.62,-.78],[.47,-.27],[.98,-.14],[.56,.1],[.74,.52],[.22,.33],[0,.6],[-.22,.33],[-.74,.52],[-.56,.1],[-.98,-.14],[-.47,-.27],[-.62,-.78],[-.2,-.5]];\n    var g = x.createLinearGradient(-r, -r, r, r); g.addColorStop(0, col[0]); g.addColorStop(1, col[1]);\n    x.fillStyle = g; x.beginPath(); pts.forEach(function(q, j){ j ? x.lineTo(q[0] * r, q[1] * r) : x.moveTo(q[0] * r, q[1] * r); }); x.closePath(); x.fill();\n    x.strokeStyle = 'rgba(60,0,0,.35)'; x.lineWidth = r * .05;\n    [[0,-.9],[.85,-.14],[-.85,-.14],[.62,.45],[-.62,.45]].forEach(function(q){ x.beginPath(); x.moveTo(0, .25 * r); x.lineTo(q[0] * r * .9, q[1] * r * .9); x.stroke(); });\n    x.beginPath(); x.moveTo(0, .55 * r); x.lineTo(0, 1.05 * r); x.lineWidth = r * .07; x.strokeStyle = col[1]; x.stroke();\n  }; }\n  function drawPetal(col){ return function(x, r){\n    var g = x.createLinearGradient(0, -r, 0, r); g.addColorStop(0, col[0]); g.addColorStop(1, col[1]);\n    x.fillStyle = g; x.beginPath(); x.moveTo(0, r);\n    x.bezierCurveTo(r * .95, r * .5, r * .82, -r * .72, r * .2, -r); x.lineTo(0, -r * .7); x.lineTo(-r * .2, -r);\n    x.bezierCurveTo(-r * .82, -r * .72, -r * .95, r * .5, 0, r); x.fill();\n    x.strokeStyle = 'rgba(200,80,110,.25)'; x.lineWidth = r * .04; x.beginPath(); x.moveTo(0, r * .9); x.lineTo(0, -r * .5); x.stroke();\n  }; }\n\n  var SP = {};\n  if (s === 'winter'){ SP.soft = [sprite(32, drawFlake, 0), sprite(32, drawFlake, 4)]; SP.crystal = [sprite(48, drawCrystal, 0), sprite(48, drawCrystal, 3)]; }\n  if (s === 'autumn'){ SP.leaf = [['#f91e11','#9b0d0d'],['#e2541b','#a61b0f'],['#d70f0f','#6e0808'],['#f08a24','#c2410c'],['#c81e1e','#7f1010']].map(function(c){ return [sprite(56, drawMaple(c), 0), sprite(56, drawMaple(c), 3)]; }); }\n  if (s === 'spring'){ SP.leaf = [['#fff0f3','#f7a9b8'],['#ffe1e8','#f48ea5'],['#ffffff','#fbc7d2']].map(function(c){ return [sprite(40, drawPetal(c), 0), sprite(40, drawPetal(c), 3)]; }); }\n  if (s === 'summer') cv.classList.add('summer'); // the sun glows like light: it brightens the dark, never covers the words\n\n  /* ---------- wind: a gentle breeze plus the odd gust ---------- */\n  var wind = 0, windTarget = .3, gust = 0, gustT = 0, nextGust = rnd(9000, 18000), clock = 0;\n  function updateWind(dt, ms){\n    clock += ms;\n    if (clock > nextGust){ gustT = 3200; gust = rnd(.8, 1) * (Math.random() < .8 ? 1 : -1); nextGust = clock + rnd(14000, 30000); if (window.__snGust) window.__snGust(); }\n    if (gustT > 0) gustT -= ms;\n    var g = gustT > 0 ? Math.sin(Math.PI * (1 - gustT / 3200)) * gust * (s === 'winter' ? 3.2 : 3.8) : 0;\n    if (Math.random() < .004) windTarget = rnd(-.1, .6);\n    wind += ((windTarget + g) - wind) * .04 * dt;\n  }\n\n  /* ---------- the pointer: things drift out of your way ---------- */\n  var mx = -999, my = -999, mt = 0;\n  function pointer(e){ var p = e.touches ? e.touches[0] : e; if (!p) return; mx = p.clientX; my = p.clientY; mt = 90; }\n  window.addEventListener('pointermove', pointer, { passive:true }); window.addEventListener('touchmove', pointer, { passive:true });\n\n  /* ---------- surfaces: things land on top of boxes and buttons ---------- */\n  var SURF_SEL = '.sn-unit,.sn-card,.sn-jobs,.sn-entry,.sn-perk,.sn-stat,.sn-claim,.sn-hunit,.sn-breeder,.sn-next-btn,.sn-btn,.sn-harv-btn,.sn-l-btn,.sn-fwa a,[data-snow]';\n  var surfs = [], piles = new Map(), resting = [];\n  function readSurfaces(){\n    surfs = [];\n    document.querySelectorAll(SURF_SEL).forEach(function(el){\n      var r = el.getBoundingClientRect(); if (r.width < 40 || r.bottom < 0 || r.top > H || el.offsetParent === null) return;\n      surfs.push({ el:el, x:r.left, y:r.top, w:r.width });\n    });\n    surfs.push({ el:'floor', x:0, y:H, w:W }); // the bottom of the screen\n  }\n  readSurfaces(); var surfTick = 0;\n  if (s === 'winter') surfs.forEach(pileOf);\n  window.addEventListener('scroll', function(){ surfTick = 99; }, { passive:true });\n  function pileOf(sf){\n    var p = piles.get(sf.el);\n    if (!p || p.n !== Math.ceil(sf.w / 4)){\n      var n = Math.ceil(sf.w / 4), h = new Float32Array(n), base = sf.el === 'floor' ? rnd(11, 15) : rnd(6, 9), ph = rnd(0, 6);\n      for (var j = 0; j < n; j++){ h[j] = base * Math.pow(Math.sin(Math.PI * (j + .5) / n), .35) * (1 + .25 * Math.sin(j * .35 + ph) + .12 * Math.sin(j * 1.3)); } // a light dusting already there\n      p = { n:n, h:h }; piles.set(sf.el, p);\n    }\n    return p;\n  }\n  function addSnow(sf, x){\n    var p = pileOf(sf), i = Math.round((x - sf.x) / 4), cap = sf.el === 'floor' ? 36 : 22;\n    for (var k = -3; k <= 3; k++){\n      var j = i + k; if (j < 0 || j >= p.n) continue;\n      var edge = Math.pow(Math.sin(Math.PI * (j + .5) / p.n), .35);  // rounded ends, like real snow on a ledge\n      p.h[j] = Math.min(cap * edge, p.h[j] + (1.1 - Math.abs(k) * .3) * 1.3);\n    }\n  }\n  function drawPiles(){\n    for (var i = 0; i < surfs.length; i++){\n      var sf = surfs[i], p = piles.get(sf.el); if (!p) continue;\n      var y0 = sf.y + (sf.el === 'floor' ? 0 : 1);\n      ctx.beginPath(); ctx.moveTo(sf.x, y0);\n      for (var j = 0; j < p.n; j++){ var a = p.h[Math.max(0, j - 1)], b = p.h[j], c = p.h[Math.min(p.n - 1, j + 1)]; ctx.lineTo(sf.x + j * 4 + 2, y0 - (a + b * 2 + c) / 4); }\n      ctx.lineTo(sf.x + sf.w, y0); ctx.closePath();\n      var g = ctx.createLinearGradient(0, y0 - 14, 0, y0); g.addColorStop(0, 'rgba(255,255,255,.97)'); g.addColorStop(1, 'rgba(205,220,240,.92)');\n      ctx.fillStyle = g; ctx.shadowColor = 'rgba(190,215,255,.45)'; ctx.shadowBlur = 6; ctx.fill(); ctx.shadowBlur = 0;\n    }\n  }\n\n  /* ---------- the particles ---------- */\n  var N = Math.round(({ spring:130, summer:26, autumn:34, winter:340 })[s] * amt * (small ? .55 : 1));\n  function make(fresh){\n    var z = Math.pow(Math.random(), 1.6) * 1.5 + .45; // most far away, a few right up close\n    var p = { z:z, x:rnd(-50, W + 50), y: fresh ? rnd(-140, -20) : rnd(-20, H), rot:rnd(0, 6.28), vr:rnd(-.03, .03) * (s === 'winter' ? 0 : 1),\n      flip:rnd(0, 6.28), vf:rnd(.025, .06), sway:rnd(0, 6.28), vs:rnd(.008, .02), vx:0, vy:0 };\n    if (s === 'winter'){ p.size = z * rnd(4, 8.5); p.crys = z > .9 && z < 1.35 && Math.random() < .35; if (p.crys) p.size *= 2.2; p.fall = .35 + z * .55; p.a = Math.min(1, .35 + z * .45); }\n    else if (s === 'summer'){ p.x = rnd(W * .35, W); p.y = rnd(0, H * .7); p.size = z * rnd(1.2, 2.6); p.dir = rnd(0, 6.28); p.sp = rnd(.05, .18); p.tw = rnd(0, 6.28); }\n    else { p.size = z * (s === 'spring' ? rnd(14, 21) : rnd(20, 32)); p.fall = .4 + z * .55; p.a = Math.min(1, .45 + z * .4); p.sp = pick(SP.leaf); }\n    return p;\n  }\n  var P = []; for (var i = 0; i < N; i++) P.push(make(false));\n\n  /* ---------- summer: a big red rising sun, like the one on the logo ---------- */\n  var sunT = 0, sunRays = null, sunBody = null, sunR = 0;\n  function bakeSun(){ // drawn once, then just turned and pulsed each frame (smooth on any phone)\n    var R = sunR = small ? 52 : 86, L = Math.ceil(R * 7);\n    sunRays = document.createElement('canvas'); sunRays.width = sunRays.height = L * 2;\n    var x = sunRays.getContext('2d'); x.translate(L, L);\n    for (var i = 0; i < 16; i++){\n      x.rotate(Math.PI / 8);\n      var g = x.createLinearGradient(0, 0, 0, -L); g.addColorStop(0, 'rgba(255,110,50,.12)'); g.addColorStop(1, 'rgba(255,110,50,0)');\n      x.fillStyle = g; x.beginPath(); x.moveTo(-R * .18, 0); x.lineTo(-R * .55, -L); x.lineTo(R * .55, -L); x.lineTo(R * .18, 0); x.fill();\n    }\n    var G = Math.ceil(R * 4.4); sunBody = document.createElement('canvas'); sunBody.width = sunBody.height = G * 2;\n    var y = sunBody.getContext('2d'); y.translate(G, G);\n    var gl = y.createRadialGradient(0, 0, R * .8, 0, 0, G); gl.addColorStop(0, 'rgba(249,60,30,.45)'); gl.addColorStop(.35, 'rgba(230,40,20,.14)'); gl.addColorStop(1, 'rgba(200,20,10,0)');\n    y.fillStyle = gl; y.beginPath(); y.arc(0, 0, G, 0, 6.29); y.fill();\n    var sg = y.createRadialGradient(-R * .3, -R * .3, R * .1, 0, 0, R); sg.addColorStop(0, '#ff5a3a'); sg.addColorStop(.6, '#f91e11'); sg.addColorStop(1, '#c80d0d');\n    y.fillStyle = sg; y.shadowColor = 'rgba(249,30,17,.9)'; y.shadowBlur = 40; y.beginPath(); y.arc(0, 0, R, 0, 6.29); y.fill();\n  }\n  function drawSun(ms){\n    if (!sunRays) bakeSun();\n    sunT += ms / 1000;\n    var cx = W - (small ? 46 : 120), cy = small ? 70 : 118, pulse = 1 + Math.sin(sunT * .6) * .03;\n    ctx.save(); ctx.translate(cx, cy); ctx.rotate(sunT * .03); ctx.globalAlpha = .85 + .15 * Math.sin(sunT * .4);\n    ctx.drawImage(sunRays, -sunRays.width / 2, -sunRays.height / 2); ctx.restore();\n    ctx.save(); ctx.translate(cx, cy); ctx.scale(pulse, pulse); ctx.globalAlpha = 1;\n    ctx.drawImage(sunBody, -sunBody.width / 2, -sunBody.height / 2); ctx.restore();\n  }\n\n\n  function canLand(p){ return p.z > .75 && p.z < 1.45; }\n\n  /* ================= the loop ================= */\n  var last = performance.now(), running = true;\n  function frame(t){\n    if (!running) return;\n    var ms = Math.min(50, t - last), dt = ms / 16.7; last = t;\n    updateWind(dt, ms);\n    if (++surfTick > 20){ surfTick = 0; readSurfaces(); if (s === 'winter') surfs.forEach(pileOf); }\n    if (mt > 0) mt -= dt;\n    ctx.clearRect(0, 0, W, H);\n\n    if (s === 'winter') drawPiles();\n    if (s === 'summer') drawSun(ms);\n\n    // things resting on boxes (leaves and petals)\n    for (var r = resting.length - 1; r >= 0; r--){\n      var q = resting[r]; q.life -= ms;\n      var host = q.sf.el === 'floor' ? { x:0, y:H } : q.sf.el.getBoundingClientRect();\n      var hx = (q.sf.el === 'floor' ? 0 : host.left) + q.dx, hy = (q.sf.el === 'floor' ? H : host.top);\n      if (q.life <= 0){ resting.splice(r, 1); continue; }\n      ctx.save(); ctx.globalAlpha = q.a * Math.min(1, q.life / 1500); ctx.translate(hx, hy - q.size * .28); ctx.rotate(q.rot); ctx.scale(1, .45);\n      var img = q.sp[0]; ctx.drawImage(img, -q.size / 2, -q.size / 2, q.size, q.size); ctx.restore();\n    }\n\n    for (var i = 0; i < P.length; i++){\n      var p = P[i];\n      // push away from the pointer\n      if (mt > 0){ var dx = p.x - mx, dy = p.y - my, d2 = dx * dx + dy * dy;\n        if (d2 < 12000){ var f = (1 - d2 / 12000) * .6 * dt; var d = Math.sqrt(d2) || 1; p.vx += dx / d * f; p.vy += dy / d * f; } }\n\n      if (s === 'summer'){\n        p.dir += rnd(-.05, .05) * dt; p.tw += .03 * dt;\n        p.x += (Math.cos(p.dir) * p.sp + p.vx) * dt; p.y += (Math.sin(p.dir) * p.sp + p.vy) * dt; p.vx *= .94; p.vy *= .94;\n        if (p.x < -10 || p.x > W + 10 || p.y < -10 || p.y > H + 10){ P[i] = make(false); continue; }\n        ctx.globalAlpha = (.35 + .35 * Math.sin(p.tw)) * Math.min(1, p.z);\n        ctx.fillStyle = '#ffd2a0'; ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, 6.29); ctx.fill();\n        continue;\n      }\n\n      p.sway += p.vs * dt; p.flip += p.vf * dt * (1 + Math.abs(wind) * .5); p.rot += (p.vr + wind * .004) * dt;\n      var py = p.y;\n      p.x += (Math.sin(p.sway) * (s === 'winter' ? .35 : .9) * p.z + wind * p.z * (s === 'winter' ? .9 : 1.2) + p.vx) * dt;\n      p.y += (p.fall + p.vy) * dt * (s === 'winter' ? 1 : 1 - Math.abs(Math.cos(p.flip)) * .25);\n      p.vx *= .94; p.vy *= .94;\n\n      // landing on a box top\n      if (canLand(p) && !still){\n        for (var k = 0; k < surfs.length; k++){\n          var sf = surfs[k];\n          if (py < sf.y && p.y >= sf.y && p.x > sf.x + 2 && p.x < sf.x + sf.w - 2){\n            if (s === 'winter'){ addSnow(sf, p.x); }\n            else if (resting.length < (small ? 10 : 22) && Math.random() < .7){\n              resting.push({ sf:sf, dx:p.x - (sf.el === 'floor' ? 0 : sf.x), size:p.size, rot:rnd(-.5, .5), sp:p.sp, a:p.a, life:rnd(5000, 11000) });\n            } else continue;\n            P[i] = make(true); p = null; break;\n          }\n        }\n        if (!p) continue;\n      }\n      if (p.y > H + 40 || p.x > W + 80 || p.x < -80){ P[i] = make(true); if (p.x > W + 80) P[i].x = rnd(-60, W * .5); if (p.x < -80) P[i].x = rnd(W * .5, W + 60); continue; }\n\n      ctx.save(); ctx.globalAlpha = p.a; ctx.translate(p.x, p.y);\n      if (s === 'winter'){\n        var img = p.crys ? SP.crystal[p.z > 1.3 ? 1 : 0] : SP.soft[p.z > 1.45 ? 1 : 0];\n        if (p.crys) ctx.rotate(p.rot += .004 * dt);\n        ctx.drawImage(img, -p.size / 2, -p.size / 2, p.size, p.size);\n      } else {\n        ctx.rotate(p.rot); var c = Math.cos(p.flip); ctx.scale(c * .85 + .15 * (c < 0 ? -1 : 1), 1);\n        var img2 = p.sp[p.z > 1.45 ? 1 : 0]; ctx.drawImage(img2, -p.size / 2, -p.size / 2, p.size, p.size);\n      }\n      ctx.restore();\n    }\n    ctx.globalAlpha = 1;\n    requestAnimationFrame(frame);\n  }\n  if (still){ running = true; frame(performance.now()); running = false; } else requestAnimationFrame(frame);\n  document.addEventListener('visibilitychange', function(){\n    if (still) return;\n    if (document.hidden) running = false; else if (!running){ running = true; last = performance.now(); requestAnimationFrame(frame); }\n  });\n\n  /* ================= music: slow koto and shakuhachi, made in the browser (nothing to download) ================= */\n  var amb = document.getElementById('snAmb'), btn = document.getElementById('snAmbBtn');\n  var AC = window.AudioContext || window.webkitAudioContext, ac = null, master = null, bus = null;\n  if (!AC) btn.style.display = 'none';\n  window.__snGust = function(){};\n\n  // the \"In\" scale (miyako-bushi), the sound of old Japan: D, Eb, G, A, Bb\n  var STEPS = [0, 1, 5, 7, 8], ROOT = 293.66;\n  function note(i){ var o = Math.floor(i / 5), d = ((i % 5) + 5) % 5; return ROOT * Math.pow(2, (12 * o + STEPS[d]) / 12); }\n\n  function impulse(sec, decay){\n    var len = Math.floor(ac.sampleRate * sec), b = ac.createBuffer(2, len, ac.sampleRate);\n    for (var c = 0; c < 2; c++){ var d = b.getChannelData(c); for (var i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, decay); }\n    return b;\n  }\n  function pan(node, p){ if (ac.createStereoPanner){ var sp = ac.createStereoPanner(); sp.pan.value = p; node.connect(sp); return sp; } return node; }\n\n  // koto: a plucked silk string, sometimes bent up a semitone the way koto players press the string\n  function koto(f, t, vel, bend){\n    var g = ac.createGain(), lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.Q.value = .7;\n    lp.frequency.setValueAtTime(4200, t); lp.frequency.exponentialRampToValueAtTime(900, t + 1.6);\n    g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vel, t + .004); g.gain.exponentialRampToValueAtTime(.0001, t + 3.2);\n    [[1, 'triangle', 1], [2, 'sine', .32], [3, 'sine', .12], [4.02, 'sine', .05]].forEach(function(h){\n      var o = ac.createOscillator(), hg = ac.createGain(); o.type = h[1];\n      o.frequency.setValueAtTime(f * h[0] * 1.012, t); o.frequency.exponentialRampToValueAtTime(f * h[0], t + .06);\n      if (bend){ o.frequency.setValueAtTime(f * h[0], t + .45); o.frequency.exponentialRampToValueAtTime(f * h[0] * 1.0595, t + .62); }\n      hg.gain.value = h[2]; o.connect(hg); hg.connect(lp); o.start(t); o.stop(t + 3.3);\n    });\n    lp.connect(g); pan(g, (Math.random() - .5) * .7).connect(bus);\n  }\n\n  // shakuhachi: a breathy bamboo flute, sliding up into each note\n  function flute(f, t, dur){\n    var g = ac.createGain(), lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 1900;\n    var o = ac.createOscillator(), o2 = ac.createOscillator(), o2g = ac.createGain(); o.type = 'sine'; o2.type = 'triangle'; o2g.gain.value = .18;\n    o.frequency.setValueAtTime(f * .94, t); o.frequency.exponentialRampToValueAtTime(f, t + .35);\n    o2.frequency.setValueAtTime(f * .94, t); o2.frequency.exponentialRampToValueAtTime(f, t + .35);\n    var lfo = ac.createOscillator(), lg = ac.createGain(); lfo.frequency.value = 4.8; lg.gain.setValueAtTime(0, t); lg.gain.linearRampToValueAtTime(f * .012, t + dur * .7);\n    lfo.connect(lg); lg.connect(o.frequency); lg.connect(o2.frequency);\n    g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(.075, t + .5); g.gain.setValueAtTime(.075, t + dur - .6); g.gain.linearRampToValueAtTime(0, t + dur + .4);\n    var br = ac.createBufferSource(), bb = ac.createBuffer(1, ac.sampleRate * 2, ac.sampleRate), bd = bb.getChannelData(0);\n    for (var i = 0; i < bd.length; i++) bd[i] = Math.random() * 2 - 1;\n    br.buffer = bb; br.loop = true; var bf = ac.createBiquadFilter(); bf.type = 'bandpass'; bf.frequency.value = f * 2; bf.Q.value = 1.4;\n    var bg = ac.createGain(); bg.gain.setValueAtTime(0, t); bg.gain.linearRampToValueAtTime(.05, t + .25); bg.gain.linearRampToValueAtTime(.012, t + .9); bg.gain.linearRampToValueAtTime(0, t + dur + .4);\n    br.connect(bf); bf.connect(bg); bg.connect(lp);\n    o.connect(lp); o2.connect(o2g); o2g.connect(lp); lp.connect(g); pan(g, .25).connect(bus);\n    [o, o2, lfo, br].forEach(function(n){ n.start(t); n.stop(t + dur + .5); });\n  }\n\n  // a soft low drone underneath, like a distant temple bowl\n  function drone(){\n    var lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 380;\n    var g = ac.createGain(); g.gain.value = .045; lp.connect(g); g.connect(bus);\n    [ROOT / 4, ROOT / 4 * 1.4983].forEach(function(f, k){\n      var o = ac.createOscillator(); o.type = 'sine'; o.frequency.value = f; o.detune.value = k ? 3 : -3;\n      var tg = ac.createGain(); tg.gain.value = .5; var l = ac.createOscillator(), lg = ac.createGain(); l.frequency.value = .05 + k * .03; lg.gain.value = .35;\n      l.connect(lg); lg.connect(tg.gain); o.connect(tg); tg.connect(lp); o.start(); l.start();\n    });\n  }\n\n  var pos = 4, phrases = 0;\n  function phrase(){\n    if (!ac) return;\n    if (ac.state !== 'running'){ setTimeout(phrase, 1500); return; }\n    var t = ac.currentTime + .15, n = 3 + Math.floor(Math.random() * 4);\n    phrases++;\n    if (phrases % 3 === 0){ // a slow low sweep across the strings\n      [0, 2, 4].forEach(function(k, j){ koto(note(k - 1), t + j * .09, .14, false); }); t += 1.6;\n    }\n    for (var i = 0; i < n; i++){\n      pos += pick([-2, -1, -1, 1, 1, 2]); pos = Math.max(1, Math.min(10, pos));\n      if (Math.random() < .2){ koto(note(pos + 1), t, .09, false); t += .13; } // a grace note\n      koto(note(pos), t, rnd(.16, .26), Math.random() < .15);\n      t += i === n - 1 ? 1.8 : rnd(.45, 1.1);\n    }\n    var rest = rnd(2.5, 6);\n    if (Math.random() < .3){ // the flute answers in the quiet\n      var ft = t + 1, fp = pos + 3;\n      for (var k = 0, m = 2 + Math.floor(Math.random() * 2); k < m; k++){ var d = rnd(1.8, 3); flute(note(fp), ft, d); ft += d + .3; fp += pick([-1, 1, -2]); }\n      rest += ft - t;\n    }\n    setTimeout(phrase, (t - ac.currentTime + rest) * 1000);\n  }\n\n  function build(){\n    ac = new AC(); master = ac.createGain(); master.gain.value = 0; master.connect(ac.destination);\n    bus = ac.createGain();\n    var conv = ac.createConvolver(); conv.buffer = impulse(3.4, 2.6);\n    var wet = ac.createGain(); wet.gain.value = .5; var dry = ac.createGain(); dry.gain.value = .75;\n    var dl = ac.createDelay(2); dl.delayTime.value = .46; var fb = ac.createGain(); fb.gain.value = .26; var dlf = ac.createBiquadFilter(); dlf.type = 'lowpass'; dlf.frequency.value = 2000;\n    bus.connect(dry); bus.connect(conv); bus.connect(dl); dl.connect(dlf); dlf.connect(fb); fb.connect(dl); dlf.connect(conv);\n    conv.connect(wet); dry.connect(master); wet.connect(master);\n    drone(); setTimeout(phrase, 600);\n  }\n  function setOn(on){\n    amb.classList.toggle('on', on); btn.setAttribute('aria-pressed', on);\n    btn.setAttribute('aria-label', on ? 'Turn the music off' : 'Turn the music on');\n    try { localStorage.setItem('sn-sound', on ? 'on' : 'off'); } catch(e){}\n  }\n  function start(){\n    if (!AC) return; if (!ac) build(); ac.resume();\n    var t = ac.currentTime; master.gain.cancelScheduledValues(t); master.gain.setValueAtTime(master.gain.value, t); master.gain.linearRampToValueAtTime(.8, t + 2.5);\n    setOn(true);\n  }\n  function stop(){\n    if (ac){ var t = ac.currentTime; master.gain.cancelScheduledValues(t); master.gain.setValueAtTime(master.gain.value, t); master.gain.linearRampToValueAtTime(0, t + .6);\n      setTimeout(function(){ if (ac && !amb.classList.contains('on')) ac.suspend(); }, 700); }\n    setOn(false);\n  }\n  btn.addEventListener('click', function(){ var playing = ac && ac.state === 'running' && amb.classList.contains('on'); playing ? stop() : start(); });\n\n  var wasOn = false; try { wasOn = localStorage.getItem('sn-sound') === 'on'; } catch(e){}\n  if (wasOn && AC){\n    amb.classList.add('on');\n    var resume = function(e){\n      if (e && e.target && e.target.closest && e.target.closest('#snAmbBtn')) return;\n      document.removeEventListener('pointerdown', resume, true); document.removeEventListener('keydown', resume, true);\n      if (amb.classList.contains('on')) start();\n    };\n    document.addEventListener('pointerdown', resume, true); document.addEventListener('keydown', resume, true);\n  }\n  document.addEventListener('visibilitychange', function(){ if (!ac) return; if (document.hidden) ac.suspend(); else if (amb.classList.contains('on')) ac.resume(); });\n})();\n</script>",
